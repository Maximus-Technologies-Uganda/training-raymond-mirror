+import { fireEvent, render, screen } from '@testing-library/react';
+import Quote from '../pages/Quote.js';
+
+const SAMPLE_QUOTES = [
+  {
+    id: 'quote-1',
+    text: 'The only limit to our realization of tomorrow is our doubts of today.',
+    author: 'Franklin D. Roosevelt',
+    tags: ['leadership', 'courage'],
+  },
+  {
+    id: 'quote-2',
+    text: 'Still I rise.',
+    author: 'Maya Angelou',
+    tags: ['hope', 'resilience'],
+  },
+  {
+    id: 'quote-3',
+    text: 'Genius is one percent inspiration and ninety-nine percent perspiration.',
+    author: 'Thomas Edison',
+    tags: ['perseverance', 'innovation'],
+  },
+] as const;
+
+describe('Quote UI', () => {
+  it('filters quotes by author case-insensitively', () => {
+    render(<Quote quotes={SAMPLE_QUOTES} />);
+
+    const authorInput = screen.getByTestId('quote-author-input');
+    fireEvent.change(authorInput, { target: { value: 'maya angelou' } });
+
+    expect(screen.getByTestId('quote-results-count')).toHaveTextContent('Showing 1 result');
+    const cards = screen.getAllByTestId('quote-result-card');
+    expect(cards).toHaveLength(1);
+    expect(screen.getByTestId('quote-result-author')).toHaveTextContent('Maya Angelou');
+  });
+
+  it('filters quotes by tag case-insensitively', () => {
+    render(<Quote quotes={SAMPLE_QUOTES} />);
+
+    const tagInput = screen.getByTestId('quote-tag-input');
+    fireEvent.change(tagInput, { target: { value: 'RESILIENCE' } });
+
+    expect(screen.getByTestId('quote-results-count')).toHaveTextContent('Showing 1 result');
+    expect(screen.getByTestId('quote-result-text')).toHaveTextContent('Still I rise.');
+  });
+
+  it('shows an informative message when no quotes exist', () => {
+    render(<Quote quotes={[]} />);
+
+    expect(screen.getByTestId('quote-empty')).toHaveTextContent('No quotes available.');
+  });
+
+  it('selects deterministic quotes based on seed when no filters are active', () => {
+    render(<Quote quotes={SAMPLE_QUOTES} />);
+
+    const seedInput = screen.getByTestId('quote-seed-input');
+
+    fireEvent.change(seedInput, { target: { value: 'alpha' } });
+    const alphaQuote = screen.getByTestId('quote-result-text').textContent;
+
+    fireEvent.change(seedInput, { target: { value: 'beta' } });
+    const betaQuote = screen.getByTestId('quote-result-text').textContent;
+    expect(betaQuote).not.toBe(alphaQuote);
+
+    fireEvent.change(seedInput, { target: { value: 'alpha' } });
+    expect(screen.getByTestId('quote-result-text').textContent).toBe(alphaQuote);
+  });
+});
