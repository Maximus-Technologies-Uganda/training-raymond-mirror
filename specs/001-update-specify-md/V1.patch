+++ b/apps/ui/src/pages/ToDo.tsx
@@ -0,0 +1,142 @@
+import { useMemo, useState } from 'react';
+import { TodoCompleteForm, TodoForm, TodoList } from '../components/index.js';
+import {
+  addTodo,
+  buildTodoView,
+  completeTodo,
+  createInitialState,
+  type TodoInput,
+  type TodoState,
+} from '../lib/todo/todos.js';
+import { createSystemClock, type Clock } from '../lib/time/clock.js';
+
+interface FeedbackState {
+  type: 'success' | 'error';
+  message: string;
+}
+
+export interface ToDoProps {
+  clock?: Clock;
+  initialState?: TodoState;
+}
+
+function toMessage(error: unknown): string {
+  if (error instanceof Error && error.message) {
+    return error.message;
+  }
+  return 'Something went wrong. Please try again.';
+}
+
+export default function ToDo({ clock, initialState }: ToDoProps = {}): JSX.Element {
+  const resolvedClock = useMemo<Clock>(() => clock ?? createSystemClock(), [clock]);
+  const [state, setState] = useState<TodoState>(() => initialState ?? createInitialState(resolvedClock));
+  const [feedback, setFeedback] = useState<FeedbackState | null>(null);
+
+  const view = useMemo(() => buildTodoView(state, resolvedClock), [state, resolvedClock]);
+
+  const handleAdd = (input: TodoInput): boolean => {
+    let wasAdded = false;
+    setState((previous) => {
+      try {
+        const result = addTodo(previous, input, resolvedClock);
+        setFeedback({ type: 'success', message: `Added “${result.item.title}”.` });
+        wasAdded = true;
+        return result.state;
+      } catch (error) {
+        setFeedback({ type: 'error', message: toMessage(error) });
+        return previous;
+      }
+    });
+    return wasAdded;
+  };
+
+  const handleComplete = (id: string): boolean => {
+    let wasCompleted = false;
+    setState((previous) => {
+      try {
+        const result = completeTodo(previous, id, resolvedClock);
+        if (result.item.completed) {
+          setFeedback({ type: 'success', message: `Completed “${result.item.title}”.` });
+        } else {
+          setFeedback({ type: 'success', message: `Task “${result.item.title}” was already completed.` });
+        }
+        wasCompleted = true;
+        return result.state;
+      } catch (error) {
+        setFeedback({ type: 'error', message: toMessage(error) });
+        return previous;
+      }
+    });
+    return wasCompleted;
+  };
+
+  return (
+    <section className="todo-page" aria-labelledby="todo-heading">
+      <header className="todo-page__header">
+        <h1 id="todo-heading">Team ToDo tracker</h1>
+        <p>
+          Capture action items, keep due dates deterministic, and mark work complete without relying on
+          local system clocks.
+        </p>
+      </header>
+
+      {feedback ? (
+        <div
+          className={`todo-feedback todo-feedback--${feedback.type}`}
+          role={feedback.type === 'error' ? 'alert' : 'status'}
+          data-testid="todo-feedback"
+        >
+          {feedback.message}
+        </div>
+      ) : null}
+
+      <div className="todo-page__forms">
+        <TodoForm onSubmit={handleAdd} />
+        <TodoCompleteForm onComplete={handleComplete} />
+      </div>
+
+      <section className="todo-summary" aria-label="Task summary">
+        <h2>Summary</h2>
+        <dl className="todo-summary__metrics">
+          <div className="todo-summary__metric">
+            <dt>Total</dt>
+            <dd>{view.summary.total}</dd>
+          </div>
+          <div className="todo-summary__metric">
+            <dt>Active</dt>
+            <dd>{view.summary.active}</dd>
+          </div>
+          <div className="todo-summary__metric">
+            <dt>Completed</dt>
+            <dd>{view.summary.completed}</dd>
+          </div>
+          <div className="todo-summary__metric">
+            <dt>Due today</dt>
+            <dd>{view.summary.dueToday}</dd>
+          </div>
+          <div className="todo-summary__metric">
+            <dt>Overdue</dt>
+            <dd>{view.summary.overdue}</dd>
+          </div>
+        </dl>
+      </section>
+
+      <TodoList
+        heading="Active tasks"
+        description="Sorted by urgency and priority."
+        items={view.active}
+        emptyMessage="All tasks are complete."
+        onComplete={handleComplete}
+        testId="todo-active-list"
+      />
+
+      <TodoList
+        heading="Completed tasks"
+        description="Recently finished items remain visible for reviewability."
+        items={view.completed}
+        emptyMessage="No tasks have been completed yet."
+        testId="todo-completed-list"
+      />
+    </section>
+  );
+}
