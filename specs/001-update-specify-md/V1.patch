+import { test, expect } from '@playwright/test';
+
+test.describe('todo ui smoke test', () => {
+  test('add → list → complete flow', async ({ page }) => {
+    await page.goto('/');
+
+    await page.getByRole('button', { name: 'ToDo' }).click();
+
+    await page.getByLabel('Task title').fill('Write smoke test');
+    await page.getByLabel('Due date').fill('2025-05-20');
+    await page.getByLabel('Priority').selectOption('medium');
+    await page.getByRole('button', { name: 'Add task' }).click();
+
+    const activeList = page.getByTestId('todo-active-list');
+    const addedItem = activeList.locator('li', { hasText: 'Write smoke test' });
+    await expect(addedItem).toBeVisible();
+
+    await addedItem.getByRole('button', { name: 'Mark complete' }).click();
+
+    const completedList = page.getByTestId('todo-completed-list');
+    await expect(completedList.getByText('Write smoke test')).toBeVisible();
+  });
+});
