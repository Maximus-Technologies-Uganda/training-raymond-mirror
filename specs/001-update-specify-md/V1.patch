+export type SeededRandom = () => number;
+
+function normalizeSeed(input: number | string): number {
+  if (typeof input === 'number' && Number.isFinite(input)) {
+    const normalized = Math.abs(Math.floor(input)) % 0x100000000;
+    return normalized === 0 ? 1 : normalized;
+  }
+
+  if (typeof input === 'string') {
+    let hash = 0;
+    for (let index = 0; index < input.length; index += 1) {
+      hash = (hash * 31 + input.charCodeAt(index)) >>> 0;
+    }
+    return hash === 0 ? 1 : hash;
+  }
+
+  return 1;
+}
+
+/**
+ * Creates a deterministic pseudo-random number generator based on a seed.
+ * The generator matches Math.random semantics (0 ≤ n < 1) while remaining reproducible.
+ */
+export function createSeededRandom(seed: number | string = Date.now()): SeededRandom {
+  let state = normalizeSeed(seed);
+  const modulus = 0x100000000;
+  const multiplier = 1664525;
+  const increment = 1013904223;
+
+  return () => {
+    state = (multiplier * state + increment) % modulus;
+    return state / modulus;
+  };
+}
+
+export interface TestClock {
+  now: () => Date;
+  advanceBy: (milliseconds: number) => Date;
+  set: (next: Date | number | string) => Date;
+  reset: () => Date;
+}
+
+function toDate(value: Date | number | string): Date {
+  if (value instanceof Date) {
+    return new Date(value.getTime());
+  }
+
+  const parsed = new Date(value);
+  if (Number.isNaN(parsed.getTime())) {
+    throw new Error('Invalid date value provided to test clock.');
+  }
+
+  return parsed;
+}
+
+/**
+ * Builds a deterministic clock for tests. It returns copies of the tracked Date
+ * to avoid accidental mutation across assertions.
+ */
+export function createTestClock(initial: Date | number | string = new Date()): TestClock {
+  const baseline = toDate(initial);
+  let current = new Date(baseline.getTime());
+
+  return {
+    now: () => new Date(current.getTime()),
+    advanceBy: (milliseconds: number) => {
+      current = new Date(current.getTime() + milliseconds);
+      return new Date(current.getTime());
+    },
+    set: (next: Date | number | string) => {
+      current = toDate(next);
+      return new Date(current.getTime());
+    },
+    reset: () => {
+      current = new Date(baseline.getTime());
+      return new Date(current.getTime());
+    },
+  };
+}
