@@ -0,0 +1,54 @@
+import type { TodoViewItem } from '../../lib/todo/todos.js';
+
+export interface TodoListProps {
+  heading: string;
+  description?: string;
+  items: readonly TodoViewItem[];
+  emptyMessage: string;
+  onComplete?: (id: string) => void;
+  testId?: string;
+}
+
+function formatPriority(priority: string): string {
+  return priority.slice(0, 1).toUpperCase() + priority.slice(1);
+}
+
+export function TodoList({ heading, description, items, emptyMessage, onComplete, testId }: TodoListProps): JSX.Element {
+  return (
+    <section className="todo-list" aria-label={heading} data-testid={testId}>
+      <header className="todo-list__header">
+        <h2>{heading}</h2>
+        {description ? <p>{description}</p> : null}
+      </header>
+
+      {items.length === 0 ? (
+        <p className="todo-list__empty" role="note">
+          {emptyMessage}
+        </p>
+      ) : (
+        <ul className="todo-list__items">
+          {items.map((item) => (
+            <li key={item.id} className={`todo-list__item todo-list__item--${item.dueStatus}`}>
+              <div className="todo-list__item-main">
+                <span className="todo-list__item-title">{item.title}</span>
+                <span className={`todo-list__badge todo-list__badge--${item.priority}`} aria-label={`Priority ${item.priority}`}>
+                  {formatPriority(item.priority)}
+                </span>
+              </div>
+              <div className="todo-list__item-meta">
+                <span className="todo-list__item-due" data-testid={`todo-due-${item.id}`}>
+                  {item.dueLabel}
+                </span>
+              </div>
+              {!item.completed && onComplete ? (
+                <button type="button" className="todo-list__complete" onClick={() => onComplete(item.id)}>
+                  Mark complete
+                </button>
+              ) : null}
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
