+import { FormEvent } from 'react';
+
+export interface QuoteFiltersFormProps {
+  author: string;
+  tag: string;
+  seed: string;
+  hasActiveFilters: boolean;
+  onAuthorChange(value: string): void;
+  onTagChange(value: string): void;
+  onSeedChange(value: string): void;
+  onClear(): void;
+}
+
+/**
+ * Controlled form for author/tag filters and deterministic seed input.
+ */
+export function QuoteFiltersForm({
+  author,
+  tag,
+  seed,
+  hasActiveFilters,
+  onAuthorChange,
+  onTagChange,
+  onSeedChange,
+  onClear,
+}: QuoteFiltersFormProps): JSX.Element {
+  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+  };
+
+  return (
+    <form className="quote-filters" aria-label="Quote filters" onSubmit={handleSubmit}>
+      <div className="quote-filters__group">
+        <label htmlFor="quote-author" className="quote-filters__label">
+          Author
+        </label>
+        <input
+          id="quote-author"
+          name="author"
+          type="text"
+          className="quote-filters__input"
+          value={author}
+          onChange={(event) => onAuthorChange(event.target.value)}
+          placeholder="e.g. Maya Angelou"
+          data-testid="quote-author-input"
+        />
+        <p className="quote-filters__help">Filters exact author name. Case-insensitive.</p>
+      </div>
+
+      <div className="quote-filters__group">
+        <label htmlFor="quote-tag" className="quote-filters__label">
+          Tag
+        </label>
+        <input
+          id="quote-tag"
+          name="tag"
+          type="text"
+          className="quote-filters__input"
+          value={tag}
+          onChange={(event) => onTagChange(event.target.value)}
+          placeholder="e.g. resilience"
+          data-testid="quote-tag-input"
+        />
+        <p className="quote-filters__help">Matches any tag attached to the quote. Case-insensitive.</p>
+      </div>
+
+      <div className="quote-filters__group">
+        <label htmlFor="quote-seed" className="quote-filters__label">
+          Seed (random mode)
+        </label>
+        <input
+          id="quote-seed"
+          name="seed"
+          type="text"
+          className="quote-filters__input"
+          value={seed}
+          onChange={(event) => onSeedChange(event.target.value)}
+          placeholder="Deterministic seed"
+          data-testid="quote-seed-input"
+        />
+        <p className="quote-filters__help">
+          When no filters are active, the seed controls which quote is selected deterministically.
+        </p>
+      </div>
+
+      <div className="quote-filters__actions">
+        <button
+          type="button"
+          className="quote-filters__clear"
+          onClick={onClear}
+          disabled={!hasActiveFilters}
+          data-testid="quote-clear-button"
+        >
+          Clear filters
+        </button>
+      </div>
+    </form>
+  );
+}
+
+export default QuoteFiltersForm;
