+++ b/apps/ui/src/components/expenses/TotalsPanel.tsx
@@ -0,0 +1,69 @@
+import type { ExpenseTotalsResult } from '../../lib/expenses/totals';
+
+interface TotalsPanelProps {
+  totals: ExpenseTotalsResult | null;
+  currency: string;
+  hasActiveFilters: boolean;
+}
+
+export default function TotalsPanel({
+  totals,
+  currency,
+  hasActiveFilters
+}: TotalsPanelProps): JSX.Element {
+  const formatter = new Intl.NumberFormat('en-US', {
+    style: 'currency',
+    currency,
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2
+  });
+
+  if (totals === null) {
+    return (
+      <section className="totals" aria-live="polite">
+        <h3>Expenses Summary</h3>
+        <p className="totals-empty">Fix the errors above to see totals.</p>
+      </section>
+    );
+  }
+
+  if (totals.entries.length === 0) {
+    return (
+      <section className="totals" aria-live="polite">
+        <h3>Expenses Summary</h3>
+        <p className="totals-empty">
+          {hasActiveFilters
+            ? 'No expenses match the selected filters yet.'
+            : 'No expenses found in the dataset.'}
+        </p>
+      </section>
+    );
+  }
+
+  return (
+    <section className="totals" aria-live="polite">
+      <h3>Expenses Summary</h3>
+      <p data-testid="expenses-total" className="totals-grand">
+        Total: {formatter.format(totals.total)}
+      </p>
+      <table aria-label="Totals by category" className="totals-table">
+        <thead>
+          <tr>
+            <th scope="col">Category</th>
+            <th scope="col" className="numeric">
+              Amount
+            </th>
+          </tr>
+        </thead>
+        <tbody>
+          {totals.totalsByCategory.map((entry) => (
+            <tr key={entry.category}>
+              <th scope="row">{entry.category}</th>
+              <td className="numeric">{formatter.format(entry.total)}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
diff --git a/apps/ui/src/lib/expenses/totals.ts b/apps/ui/src/lib/expenses/totals.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ab47704108ba5f2dfb30e03764216b943307fc9d
--- /dev/null
+++ b/apps/ui/src/lib/expenses/totals.ts
@@ -0,0 +1,229 @@
+export interface ExpenseDatum {
+  id: string;
+  date: string; // YYYY-MM-DD
+  category: string;
+  amount: number;
+  currency: string;
+}
+
+export interface ExpenseDataset {
+  currency: string;
+  records: ExpenseDatum[];
+}
+
+export interface ExpenseTotalsFilters {
+  month?: string | number | null;
+  category?: string | null;
+}
+
+export interface ExpenseTotalsByCategory {
+  category: string;
+  total: number;
+}
+
+export interface ExpenseTotalsResult {
+  total: number;
+  totalsByCategory: ExpenseTotalsByCategory[];
+  entries: ExpenseDatum[];
+}
+
+const MONTH_NAMES = [
+  'January',
+  'February',
+  'March',
+  'April',
+  'May',
+  'June',
+  'July',
+  'August',
+  'September',
+  'October',
+  'November',
+  'December'
+];
+
+function ensureString(value: string | null | undefined): string | null {
+  if (value === undefined || value === null) {
+    return null;
+  }
+  const trimmed = String(value).trim();
+  return trimmed.length === 0 ? null : trimmed;
+}
+
+export class UnknownMonthError extends Error {
+  constructor(value: string, available: string[]) {
+    super(`Unknown month "${value}". Choose one of: ${available.join(', ')}.`);
+    this.name = 'UnknownMonthError';
+  }
+}
+
+export class UnknownCategoryError extends Error {
+  constructor(value: string, available: string[]) {
+    super(`Unknown category "${value}". Choose one of: ${available.join(', ')}.`);
+    this.name = 'UnknownCategoryError';
+  }
+}
+
+function parseMonth(value: string | number): number {
+  if (typeof value === 'number' && Number.isInteger(value)) {
+    if (value >= 1 && value <= 12) {
+      return value;
+    }
+    throw new Error('Month must be between 1 and 12.');
+  }
+
+  const normalized = String(value).trim().toLowerCase();
+  if (normalized === '') {
+    throw new Error('Month cannot be empty.');
+  }
+
+  const numeric = Number.parseInt(normalized, 10);
+  if (!Number.isNaN(numeric)) {
+    if (numeric >= 1 && numeric <= 12) {
+      return numeric;
+    }
+    throw new Error('Month must be between 1 and 12.');
+  }
+
+  const monthIndex = MONTH_NAMES.findIndex((month) => month.toLowerCase().startsWith(normalized));
+  if (monthIndex === -1) {
+    throw new Error('Invalid month value.');
+  }
+  return monthIndex + 1;
+}
+
+function toMonthNumber(date: string): number {
+  const parsed = new Date(`${date}T00:00:00Z`);
+  if (Number.isNaN(parsed.getTime())) {
+    throw new Error(`Invalid expense date: ${date}`);
+  }
+  return parsed.getUTCMonth() + 1;
+}
+
+function normalizeCategory(value: string): string {
+  return value.trim().toLowerCase();
+}
+
+export function getAvailableMonths(dataset: ExpenseDataset): string[] {
+  const unique = new Set<number>();
+  dataset.records.forEach((record) => {
+    unique.add(toMonthNumber(record.date));
+  });
+  return Array.from(unique)
+    .sort((a, b) => a - b)
+    .map((month) => MONTH_NAMES[month - 1]);
+}
+
+export function getAvailableCategories(dataset: ExpenseDataset): string[] {
+  const unique = new Set<string>();
+  dataset.records.forEach((record) => {
+    unique.add(record.category);
+  });
+  return Array.from(unique).sort((a, b) => a.localeCompare(b));
+}
+
+export function calculateExpenseTotals(
+  dataset: ExpenseDataset,
+  filters: ExpenseTotalsFilters = {}
+): ExpenseTotalsResult {
+  const availableMonths = getAvailableMonths(dataset);
+  const availableMonthNumbers = new Set(
+    availableMonths.map((month) => MONTH_NAMES.indexOf(month) + 1)
+  );
+  const availableCategories = getAvailableCategories(dataset);
+  const availableCategorySet = new Set(availableCategories.map((category) => normalizeCategory(category)));
+
+  const monthFilterRaw = ensureString(filters.month as string | null);
+  const categoryFilterRaw = ensureString(filters.category ?? null);
+
+  let monthFilter: number | null = null;
+  if (monthFilterRaw !== null) {
+    try {
+      monthFilter = parseMonth(monthFilterRaw);
+    } catch (error) {
+      throw new UnknownMonthError(monthFilterRaw, availableMonths);
+    }
+    if (!availableMonthNumbers.has(monthFilter)) {
+      throw new UnknownMonthError(monthFilterRaw, availableMonths);
+    }
+  }
+
+  let categoryFilter: string | null = null;
+  if (categoryFilterRaw !== null) {
+    const normalized = normalizeCategory(categoryFilterRaw);
+    if (!availableCategorySet.has(normalized)) {
+      throw new UnknownCategoryError(categoryFilterRaw, availableCategories);
+    }
+    categoryFilter = normalized;
+  }
+
+  const filteredEntries = dataset.records.filter((record) => {
+    const recordMonth = toMonthNumber(record.date);
+    const matchesMonth = monthFilter === null || recordMonth === monthFilter;
+    const matchesCategory =
+      categoryFilter === null || normalizeCategory(record.category) === categoryFilter;
+    return matchesMonth && matchesCategory;
+  });
+
+  const totalsByCategory = filteredEntries.reduce<ExpenseTotalsByCategory[]>((accumulator, entry) => {
+    const existing = accumulator.find(
+      (item) => normalizeCategory(item.category) === normalizeCategory(entry.category)
+    );
+    if (existing) {
+      existing.total += entry.amount;
+      return accumulator;
+    }
+    return [...accumulator, { category: entry.category, total: entry.amount }];
+  }, []);
+
+  totalsByCategory.sort((a, b) => a.category.localeCompare(b.category));
+
+  const total = filteredEntries.reduce((sum, entry) => sum + entry.amount, 0);
+
+  return {
+    total,
+    totalsByCategory,
+    entries: filteredEntries
+  };
+}
+
+export const EXPENSES_DATASET: ExpenseDataset = {
+  currency: 'USD',
+  records: [
+    {
+      id: 'exp-2025-01-10-groceries',
+      date: '2025-01-10',
+      category: 'Groceries',
+      amount: 120.45,
+      currency: 'USD'
+    },
+    {
+      id: 'exp-2025-02-14-groceries',
+      date: '2025-02-14',
+      category: 'Groceries',
+      amount: 95.1,
+      currency: 'USD'
+    },
+    {
+      id: 'exp-2025-02-02-transport',
+      date: '2025-02-02',
+      category: 'Transport',
+      amount: 45.2,
+      currency: 'USD'
+    },
+    {
+      id: 'exp-2025-03-05-utilities',
+      date: '2025-03-05',
+      category: 'Utilities',
+      amount: 150.75,
+      currency: 'USD'
+    },
+    {
+      id: 'exp-2025-03-18-groceries',
+      date: '2025-03-18',
+      category: 'Groceries',
+      amount: 80,
+      currency: 'USD'
+    }
+  ]
+};
