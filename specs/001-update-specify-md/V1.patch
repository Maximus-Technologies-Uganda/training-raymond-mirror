diff --git a/apps/ui/src/tests/todo.test.tsx b/apps/ui/src/tests/todo.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1857f64167da58b32b4092310e661ad72b0f779d
--- /dev/null
+++ b/apps/ui/src/tests/todo.test.tsx
@@ -0,0 +1,104 @@
+import { render, screen, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import ToDo from '../pages/ToDo';
+import {
+  addTodo,
+  completeTodo,
+  createInitialState,
+  createSeedTodos,
+  evaluateDueStatus,
+} from '../lib/todo/todos';
+import { createFixedClock } from '../lib/time/clock';
+
+describe('todo due status evaluation', () => {
+  const clock = createFixedClock('2025-05-15T10:00:00Z');
+  const baseline = createSeedTodos(clock);
+
+  it('marks yesterday tasks as overdue', () => {
+    const item = baseline[0];
+    expect(evaluateDueStatus(item, clock)).toBe('overdue');
+  });
+
+  it('marks today tasks as due today', () => {
+    const item = baseline[1];
+    expect(evaluateDueStatus(item, clock)).toBe('due-today');
+  });
+
+  it('marks tomorrow tasks as upcoming', () => {
+    const item = baseline[2];
+    expect(evaluateDueStatus(item, clock)).toBe('upcoming');
+  });
+});
+
+describe('todo state transitions', () => {
+  const clock = createFixedClock('2025-05-15T10:00:00Z');
+  const state = createInitialState(clock);
+
+  it('prevents adding duplicate titles', () => {
+    expect(() => addTodo(state, { title: 'Review expense receipts' }, clock)).toThrow(
+      /already exists/i,
+    );
+  });
+
+  it('throws when completing an unknown id', () => {
+    expect(() => completeTodo(state, '999', clock)).toThrow(/id not found/i);
+  });
+});
+
+describe('ToDo page behaviour', () => {
+  const clock = createFixedClock('2025-05-15T10:00:00Z');
+
+  it('displays due status labels for seed tasks', () => {
+    const initialState = createInitialState(clock);
+    render(<ToDo clock={clock} initialState={initialState} />);
+
+    const list = screen.getByTestId('todo-active-list');
+    expect(within(list).getByText(/Overdue/)).toBeInTheDocument();
+    expect(within(list).getByText(/Due today/)).toBeInTheDocument();
+    expect(within(list).getByText(/Upcoming/)).toBeInTheDocument();
+  });
+
+  it('shows error feedback when duplicate title is submitted', async () => {
+    render(<ToDo clock={clock} />);
+    const user = userEvent.setup();
+
+    await user.type(screen.getByLabelText(/Task title/i), 'Review expense receipts');
+    await user.click(screen.getByRole('button', { name: /Add task/i }));
+
+    const feedback = await screen.findByTestId('todo-feedback');
+    expect(feedback).toHaveTextContent(/already exists/i);
+  });
+
+  it('moves a task to completed when marked complete from list', async () => {
+    render(<ToDo clock={clock} />);
+    const user = userEvent.setup();
+
+    await user.clear(screen.getByLabelText(/Task title/i));
+    await user.type(screen.getByLabelText(/Task title/i), 'Schedule retro');
+    await user.type(screen.getByLabelText(/Due date/i), '2025-05-18');
+    await user.selectOptions(screen.getByLabelText(/Priority/i), 'high');
+    await user.click(screen.getByRole('button', { name: /Add task/i }));
+
+    const newTask = await screen.findByText('Schedule retro');
+    const item = newTask.closest('li');
+    expect(item).not.toBeNull();
+    if (item) {
+      const completeButton = within(item).getByRole('button', { name: /Mark complete/i });
+      await user.click(completeButton);
+    }
+
+    const completedList = screen.getByTestId('todo-completed-list');
+    expect(within(completedList).getByText('Schedule retro')).toBeInTheDocument();
+  });
+
+  it('shows error feedback when completing an unknown id through the form', async () => {
+    render(<ToDo clock={clock} />);
+    const user = userEvent.setup();
+
+    await user.type(screen.getByLabelText(/Complete by id/i), '999');
+    await user.click(screen.getByRole('button', { name: /Mark complete/i }));
+
+    const feedback = await screen.findByTestId('todo-feedback');
+    expect(feedback).toHaveTextContent(/id not found/i);
+  });
+});
