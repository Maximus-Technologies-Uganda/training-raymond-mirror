+import { QuoteDisplay } from './types.js';
+
+export interface QuoteResultCardProps {
+  quote: QuoteDisplay;
+  highlight?: boolean;
+}
+
+export function QuoteResultCard({ quote, highlight = false }: QuoteResultCardProps): JSX.Element {
+  const className = `quote-card${highlight ? ' quote-card--highlight' : ''}`;
+  return (
+    <article className={className} data-testid="quote-result-card">
+      <p className="quote-card__text" data-testid="quote-result-text">
+        “{quote.text}”
+      </p>
+      <p className="quote-card__author" data-testid="quote-result-author">
+        — {quote.author}
+      </p>
+      {quote.tags.length > 0 ? (
+        <ul className="quote-card__tags" aria-label={`Tags for ${quote.author}`} data-testid="quote-result-tags">
+          {quote.tags.map((tag) => (
+            <li key={tag} className="quote-card__tag">
+              {tag}
+            </li>
+          ))}
+        </ul>
+      ) : (
+        <p className="quote-card__tags quote-card__tags--empty" data-testid="quote-result-tags-empty">
+          No tags provided.
+        </p>
+      )}
+    </article>
+  );
+}
+
+export default QuoteResultCard;
