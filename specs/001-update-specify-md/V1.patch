+++ b/apps/ui/src/pages/Quote.tsx
@@ -0,0 +1,201 @@
+import { useMemo, useState } from 'react';
+import rawQuotes from '../../../data/quotes.json';
+import QuoteFiltersForm from '../components/quote/QuoteFiltersForm.js';
+import QuoteResultCard from '../components/quote/QuoteResultCard.js';
+import QuoteResultsList from '../components/quote/QuoteResultsList.js';
+import type { QuoteDisplay } from '../components/quote/types.js';
+import { createSeededRandom, type SeededRandomFactory } from '../lib/random/seeded.js';
+
+interface QuoteInput {
+  id?: string;
+  text: string;
+  author: string;
+  tags?: readonly string[];
+}
+
+interface QuoteFilters {
+  author: string;
+  tag: string;
+}
+
+export interface QuoteProps {
+  quotes?: readonly QuoteInput[];
+  createRandom?: SeededRandomFactory;
+}
+
+const DEFAULT_SEED = 'quote-ui';
+
+function toStringValue(value: unknown): string {
+  if (typeof value === 'string') {
+    return value.trim();
+  }
+  if (value === undefined || value === null) {
+    return '';
+  }
+  return String(value).trim();
+}
+
+function normalizeQuote(quote: QuoteInput, index: number): QuoteDisplay {
+  const text = toStringValue(quote.text);
+  const author = toStringValue(quote.author);
+  const tags = quote.tags ? Array.from(quote.tags) : [];
+  const normalizedTags = tags
+    .map((tag) => toStringValue(tag))
+    .filter((tag) => tag.length > 0);
+
+  const normalizedText = text.length > 0 ? text : `Quote #${index + 1}`;
+  const normalizedAuthor = author.length > 0 ? author : 'Unknown';
+  const normalizedId =
+    typeof quote.id === 'string' && quote.id.trim().length > 0 ? quote.id.trim() : `quote-${index}`;
+
+  return {
+    id: normalizedId,
+    text: normalizedText,
+    author: normalizedAuthor,
+    tags: normalizedTags,
+  };
+}
+
+function buildDefaultQuotes(): readonly QuoteDisplay[] {
+  if (!Array.isArray(rawQuotes)) {
+    return [];
+  }
+
+  const inputs: QuoteInput[] = rawQuotes.map((entry: unknown) => {
+    const record = entry as Record<string, unknown>;
+    const tags = Array.isArray(record.tags) ? (record.tags as readonly string[]) : [];
+    return {
+      text: toStringValue(record.text),
+      author: toStringValue(record.author),
+      tags,
+    };
+  });
+
+  return Object.freeze(inputs.map((quote, index) => normalizeQuote(quote, index)));
+}
+
+const DEFAULT_QUOTES = buildDefaultQuotes();
+
+function normalizeFilter(value: string): string | null {
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed.toLowerCase() : null;
+}
+
+function filterQuotes(quotes: readonly QuoteDisplay[], filters: QuoteFilters): QuoteDisplay[] {
+  const author = normalizeFilter(filters.author);
+  const tag = normalizeFilter(filters.tag);
+
+  return quotes.filter((quote) => {
+    const matchesAuthor = author ? quote.author.toLowerCase() === author : true;
+    const matchesTag = tag ? quote.tags.some((entry) => entry.toLowerCase() === tag) : true;
+    return matchesAuthor && matchesTag;
+  });
+}
+
+function selectRandomQuote(
+  quotes: readonly QuoteDisplay[],
+  seed: string,
+  factory: SeededRandomFactory,
+): QuoteDisplay | null {
+  if (quotes.length === 0) {
+    return null;
+  }
+  const effectiveSeed = seed.trim().length > 0 ? seed.trim() : DEFAULT_SEED;
+  const random = factory(effectiveSeed);
+  return random.pick(quotes);
+}
+
+/**
+ * Quote explorer page supporting deterministic filters and seeded random selection.
+ */
+function Quote({ quotes = DEFAULT_QUOTES, createRandom = createSeededRandom }: QuoteProps): JSX.Element {
+  const [author, setAuthor] = useState('');
+  const [tag, setTag] = useState('');
+  const [seed, setSeed] = useState(DEFAULT_SEED);
+
+  const dataset = useMemo<QuoteDisplay[]>(() => quotes.map((quote, index) => normalizeQuote(quote, index)), [quotes]);
+
+  const hasActiveFilters = author.trim().length > 0 || tag.trim().length > 0;
+
+  const filteredQuotes = useMemo(
+    () => filterQuotes(dataset, { author, tag }),
+    [dataset, author, tag],
+  );
+
+  const randomQuote = useMemo(
+    () => (hasActiveFilters ? null : selectRandomQuote(dataset, seed, createRandom)),
+    [dataset, seed, createRandom, hasActiveFilters],
+  );
+
+  const handleClearFilters = () => {
+    setAuthor('');
+    setTag('');
+  };
+
+  const renderContent = () => {
+    if (dataset.length === 0) {
+      return (
+        <p className="quote-empty" role="alert" data-testid="quote-empty">
+          No quotes available. Provide a dataset to explore motivational snippets.
+        </p>
+      );
+    }
+
+    if (hasActiveFilters) {
+      if (filteredQuotes.length === 0) {
+        return (
+          <p className="quote-empty" role="status" data-testid="quote-no-results">
+            No quotes match the provided filters. Try adjusting the author or tag.
+          </p>
+        );
+      }
+      return <QuoteResultsList quotes={filteredQuotes} />;
+    }
+
+    if (!randomQuote) {
+      return (
+        <p className="quote-empty" role="status" data-testid="quote-empty-random">
+          Unable to select a quote. Adjust the seed or provide additional quotes.
+        </p>
+      );
+    }
+
+    return (
+      <section className="quote-random" aria-label="Featured quote" data-testid="quote-random">
+        <header className="quote-random__header">
+          <h3 className="quote-random__title">Featured quote</h3>
+          <p className="quote-random__meta">Seed: {seed.trim().length > 0 ? seed.trim() : DEFAULT_SEED}</p>
+        </header>
+        <QuoteResultCard quote={randomQuote} highlight />
+      </section>
+    );
+  };
+
+  return (
+    <div className="quote-page" role="main">
+      <header className="quote-page__header">
+        <h1 className="quote-page__title" data-testid="quote-title">
+          Quote explorer
+        </h1>
+        <p className="quote-page__subtitle">
+          Filter by author or tag to mirror the CLI experience, or leave filters blank to surface a deterministic random quote.
+        </p>
+      </header>
+
+      <QuoteFiltersForm
+        author={author}
+        tag={tag}
+        seed={seed}
+        hasActiveFilters={hasActiveFilters}
+        onAuthorChange={setAuthor}
+        onTagChange={setTag}
+        onSeedChange={setSeed}
+        onClear={handleClearFilters}
+      />
+
+      {renderContent()}
+    </div>
+  );
+}
+
+export default Quote;
