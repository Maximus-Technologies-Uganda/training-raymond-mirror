index 0000000000000000000000000000000000000000..5acb29c5d84be3a24e0881fa778fc4d6014bc23a
--- /dev/null
+++ b/apps/ui/src/lib/time/clock.ts
@@ -0,0 +1,112 @@
+export interface Clock {
+  now(): Date;
+}
+
+type ClockInput = Date | string | number;
+
+function toTimestamp(input: ClockInput): number {
+  if (input instanceof Date) {
+    const time = input.getTime();
+    if (Number.isNaN(time)) {
+      throw new Error('Invalid Date provided to clock.');
+    }
+    return time;
+  }
+
+  if (typeof input === 'number') {
+    if (!Number.isFinite(input)) {
+      throw new Error('Timestamp must be a finite number.');
+    }
+    return input;
+  }
+
+  const parsed = new Date(input);
+  const timestamp = parsed.getTime();
+  if (Number.isNaN(timestamp)) {
+    throw new Error('Invalid ISO timestamp provided to clock.');
+  }
+  return timestamp;
+}
+
+function toDate(input: ClockInput): Date {
+  return new Date(toTimestamp(input));
+}
+
+export function createSystemClock(): Clock {
+  return {
+    now(): Date {
+      return new Date();
+    },
+  };
+}
+
+export function createFixedClock(instant: ClockInput): Clock {
+  const timestamp = toTimestamp(instant);
+  return {
+    now(): Date {
+      return new Date(timestamp);
+    },
+  };
+}
+
+export function createAdvanceableClock(initial: ClockInput = new Date()): { clock: Clock; advanceBy(days: number): void; set(instant: ClockInput): void } {
+  let current = toTimestamp(initial);
+  return {
+    clock: {
+      now(): Date {
+        return new Date(current);
+      },
+    },
+    advanceBy(days: number): void {
+      if (!Number.isFinite(days)) {
+        throw new Error('Days must be a finite number.');
+      }
+      current += days * 24 * 60 * 60 * 1000;
+    },
+    set(instant: ClockInput): void {
+      current = toTimestamp(instant);
+    },
+  };
+}
+
+export function toDateOnly(input: ClockInput): string {
+  return toDate(input).toISOString().slice(0, 10);
+}
+
+export function shiftDate(input: ClockInput, days: number): Date {
+  if (!Number.isFinite(days)) {
+    throw new Error('Days must be a finite number.');
+  }
+  const date = toDate(input);
+  const utcYear = date.getUTCFullYear();
+  const utcMonth = date.getUTCMonth();
+  const utcDate = date.getUTCDate();
+  const shifted = new Date(Date.UTC(utcYear, utcMonth, utcDate + days));
+  return shifted;
+}
+
+export function addDaysToIsoDate(isoDate: string, days: number): string {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(isoDate)) {
+    throw new Error('ISO date must use YYYY-MM-DD format.');
+  }
+  const shifted = shiftDate(`${isoDate}T00:00:00.000Z`, days);
+  return toDateOnly(shifted);
+}
+
+export function compareIsoDates(left: string, right: string): number {
+  const leftDate = new Date(`${left}T00:00:00.000Z`);
+  const rightDate = new Date(`${right}T00:00:00.000Z`);
+  return Math.sign(leftDate.getTime() - rightDate.getTime());
+}
+
+export function formatIsoDateForDisplay(isoDate: string): string {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(isoDate)) {
+    return isoDate;
+  }
+  const date = new Date(`${isoDate}T00:00:00.000Z`);
+  return date.toLocaleDateString(undefined, {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
diff --git a/apps/ui/src/lib/todo/todos.ts b/apps/ui/src/lib/todo/todos.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4eff0d5cefdb0842657a9d9794b9506cce531cd6
--- /dev/null
+++ b/apps/ui/src/lib/todo/todos.ts
@@ -0,0 +1,296 @@
+import { addDaysToIsoDate, compareIsoDates, createSystemClock, formatIsoDateForDisplay, toDateOnly, type Clock } from '../time/clock.js';
+
+export type TodoPriority = 'low' | 'medium' | 'high';
+
+export interface TodoInput {
+  title: string;
+  dueDate?: string | null;
+  priority?: TodoPriority | null;
+}
+
+export interface TodoItem {
+  id: string;
+  title: string;
+  priority: TodoPriority;
+  createdAt: string;
+  completed: boolean;
+  dueDate?: string;
+  completedAt?: string;
+}
+
+export interface TodoState {
+  items: TodoItem[];
+  nextId: number;
+}
+
+export type TodoDueStatus = 'overdue' | 'due-today' | 'upcoming' | 'unscheduled';
+
+export interface TodoViewItem extends TodoItem {
+  dueStatus: TodoDueStatus;
+  dueLabel: string;
+}
+
+export interface TodoSummary {
+  total: number;
+  completed: number;
+  active: number;
+  overdue: number;
+  dueToday: number;
+}
+
+export interface TodoView {
+  active: TodoViewItem[];
+  completed: TodoViewItem[];
+  summary: TodoSummary;
+}
+
+const PRIORITIES: readonly TodoPriority[] = ['high', 'medium', 'low'];
+
+function normalizeTitle(raw: string): string {
+  const title = raw.trim();
+  if (title.length === 0) {
+    throw new Error('Title must be provided.');
+  }
+  return title;
+}
+
+function normalizePriority(raw: TodoPriority | null | undefined): TodoPriority {
+  const normalized = (raw ?? 'medium').toLowerCase();
+  if (!PRIORITIES.includes(normalized as TodoPriority)) {
+    throw new Error('Priority must be low, medium, or high.');
+  }
+  return normalized as TodoPriority;
+}
+
+function normalizeDueDate(raw: string | null | undefined): string | undefined {
+  if (raw === null || raw === undefined || raw.trim() === '') {
+    return undefined;
+  }
+  const trimmed = raw.trim();
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
+    throw new Error('Due date must use YYYY-MM-DD format.');
+  }
+  const date = new Date(`${trimmed}T00:00:00.000Z`);
+  if (Number.isNaN(date.getTime())) {
+    throw new Error('Due date is invalid.');
+  }
+  return trimmed;
+}
+
+function nextIdFromItems(items: readonly TodoItem[]): number {
+  if (items.length === 0) {
+    return 1;
+  }
+  const maxId = items.reduce((acc, item) => Math.max(acc, Number.parseInt(item.id, 10) || 0), 0);
+  return maxId + 1;
+}
+
+function toTimestampString(clock: Clock): string {
+  return clock.now().toISOString();
+}
+
+function hasDuplicateTitle(items: readonly TodoItem[], title: string): boolean {
+  const normalized = title.toLowerCase();
+  return items.some((item) => item.title.toLowerCase() === normalized);
+}
+
+export function createInitialState(clock: Clock = createSystemClock(), seed?: TodoItem[]): TodoState {
+  const baseline = seed ?? createSeedTodos(clock);
+  return {
+    items: baseline,
+    nextId: nextIdFromItems(baseline),
+  };
+}
+
+export function createSeedTodos(clock: Clock = createSystemClock()): TodoItem[] {
+  const today = toDateOnly(clock.now());
+  const yesterday = addDaysToIsoDate(today, -1);
+  const tomorrow = addDaysToIsoDate(today, 1);
+
+  const timestamp = clock.now().toISOString();
+  return [
+    {
+      id: '1',
+      title: 'Review expense receipts',
+      priority: 'high',
+      dueDate: yesterday,
+      createdAt: timestamp,
+      completed: false,
+    },
+    {
+      id: '2',
+      title: 'Prepare sprint demo outline',
+      priority: 'medium',
+      dueDate: today,
+      createdAt: timestamp,
+      completed: false,
+    },
+    {
+      id: '3',
+      title: 'Plan weekend backlog grooming',
+      priority: 'low',
+      dueDate: tomorrow,
+      createdAt: timestamp,
+      completed: false,
+    },
+  ];
+}
+
+export function addTodo(state: TodoState, input: TodoInput, clock: Clock = createSystemClock()): { state: TodoState; item: TodoItem } {
+  const title = normalizeTitle(input.title);
+  if (hasDuplicateTitle(state.items, title)) {
+    throw new Error('A task with this title already exists.');
+  }
+
+  const priority = normalizePriority(input.priority ?? 'medium');
+  const dueDate = normalizeDueDate(input.dueDate);
+
+  const item: TodoItem = {
+    id: String(state.nextId),
+    title,
+    priority,
+    dueDate,
+    createdAt: toTimestampString(clock),
+    completed: false,
+  };
+
+  const nextState: TodoState = {
+    items: [...state.items, item],
+    nextId: state.nextId + 1,
+  };
+
+  return { state: nextState, item };
+}
+
+export function completeTodo(state: TodoState, id: string, clock: Clock = createSystemClock()): { state: TodoState; item: TodoItem } {
+  const trimmedId = id.trim();
+  if (trimmedId.length === 0) {
+    throw new Error('Task id is required to complete an item.');
+  }
+
+  const index = state.items.findIndex((item) => item.id === trimmedId);
+  if (index === -1) {
+    throw new Error('Unable to complete task: id not found.');
+  }
+
+  const existing = state.items[index];
+  if (existing.completed) {
+    return { state, item: existing };
+  }
+
+  const updated: TodoItem = {
+    ...existing,
+    completed: true,
+    completedAt: toTimestampString(clock),
+  };
+
+  const items = [...state.items];
+  items[index] = updated;
+  return { state: { items, nextId: state.nextId }, item: updated };
+}
+
+export function evaluateDueStatus(item: TodoItem, clock: Clock = createSystemClock()): TodoDueStatus {
+  if (!item.dueDate) {
+    return 'unscheduled';
+  }
+  const today = toDateOnly(clock.now());
+  if (item.dueDate === today) {
+    return 'due-today';
+  }
+  const comparison = compareIsoDates(item.dueDate, today);
+  if (comparison < 0) {
+    return 'overdue';
+  }
+  return 'upcoming';
+}
+
+function buildDueLabel(item: TodoItem, status: TodoDueStatus): string {
+  if (status === 'unscheduled') {
+    return 'No due date';
+  }
+  if (!item.dueDate) {
+    return 'No due date';
+  }
+  const readable = formatIsoDateForDisplay(item.dueDate);
+  switch (status) {
+    case 'overdue':
+      return `Overdue — due ${readable}`;
+    case 'due-today':
+      return `Due today — ${readable}`;
+    default:
+      return `Upcoming — due ${readable}`;
+  }
+}
+
+function decorate(items: readonly TodoItem[], clock: Clock): TodoViewItem[] {
+  return items.map((item) => {
+    const dueStatus = evaluateDueStatus(item, clock);
+    return {
+      ...item,
+      dueStatus,
+      dueLabel: buildDueLabel(item, dueStatus),
+    };
+  });
+}
+
+function sortActive(items: TodoViewItem[]): TodoViewItem[] {
+  const statusOrder: Record<TodoDueStatus, number> = {
+    overdue: 0,
+    'due-today': 1,
+    upcoming: 2,
+    unscheduled: 3,
+  };
+  const priorityOrder: Record<TodoPriority, number> = {
+    high: 0,
+    medium: 1,
+    low: 2,
+  };
+  return [...items].sort((left, right) => {
+    if (left.dueStatus !== right.dueStatus) {
+      return statusOrder[left.dueStatus] - statusOrder[right.dueStatus];
+    }
+    if (left.dueDate && right.dueDate && left.dueDate !== right.dueDate) {
+      return compareIsoDates(left.dueDate, right.dueDate);
+    }
+    if (left.priority !== right.priority) {
+      return priorityOrder[left.priority] - priorityOrder[right.priority];
+    }
+    return Number.parseInt(left.id, 10) - Number.parseInt(right.id, 10);
+  });
+}
+
+function sortCompleted(items: TodoViewItem[]): TodoViewItem[] {
+  return [...items].sort((left, right) => {
+    if (left.completedAt && right.completedAt) {
+      return right.completedAt.localeCompare(left.completedAt);
+    }
+    if (left.completedAt) {
+      return -1;
+    }
+    if (right.completedAt) {
+      return 1;
+    }
+    return right.id.localeCompare(left.id);
+  });
+}
+
+export function buildTodoView(state: TodoState, clock: Clock = createSystemClock()): TodoView {
+  const decorated = decorate(state.items, clock);
+  const active = sortActive(decorated.filter((item) => !item.completed));
+  const completed = sortCompleted(decorated.filter((item) => item.completed));
+
+  const overdue = active.filter((item) => item.dueStatus === 'overdue').length;
+  const dueToday = active.filter((item) => item.dueStatus === 'due-today').length;
+
+  return {
+    active,
+    completed,
+    summary: {
+      total: decorated.length,
+      completed: completed.length,
+      active: active.length,
+      overdue,
+      dueToday,
+    },
+  };
+}
