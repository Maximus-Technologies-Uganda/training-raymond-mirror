+  getAvailableCategories,
+  getAvailableMonths,
+  type ExpenseTotalsResult
+} from '../lib/expenses/totals';
+
+interface FieldErrors {
+  month?: string | null;
+  category?: string | null;
+}
+
+function normalizeFilterValue(value: string): string | null {
+  const trimmed = value.trim();
+  return trimmed.length === 0 ? null : trimmed;
+}
+
+export default function Expenses(): JSX.Element {
+  const months = useMemo(() => getAvailableMonths(EXPENSES_DATASET), []);
+  const categories = useMemo(() => getAvailableCategories(EXPENSES_DATASET), []);
+
+  const [monthInput, setMonthInput] = useState('');
+  const [categoryInput, setCategoryInput] = useState('');
+  const [errors, setErrors] = useState<FieldErrors>({});
+  const [totals, setTotals] = useState<ExpenseTotalsResult | null>(() =>
+    calculateExpenseTotals(EXPENSES_DATASET)
+  );
+
+  useEffect(() => {
+    const filters = {
+      month: normalizeFilterValue(monthInput),
+      category: normalizeFilterValue(categoryInput)
+    };
+
+    const nextErrors: FieldErrors = { month: null, category: null };
+    let hasError = false;
+
+    if (filters.month !== null) {
+      try {
+        calculateExpenseTotals(EXPENSES_DATASET, { month: filters.month });
+      } catch (error) {
+        if (error instanceof UnknownMonthError) {
+          nextErrors.month = error.message;
+          hasError = true;
+        } else {
+          throw error;
+        }
+      }
+    }
+
+    if (filters.category !== null) {
+      try {
+        calculateExpenseTotals(EXPENSES_DATASET, { category: filters.category });
+      } catch (error) {
+        if (error instanceof UnknownCategoryError) {
+          nextErrors.category = error.message;
+          hasError = true;
+        } else {
+          throw error;
+        }
+      }
+    }
+
+    if (hasError) {
+      setTotals(null);
+      setErrors(nextErrors);
+      return;
+    }
+
+    const result = calculateExpenseTotals(EXPENSES_DATASET, filters);
+    setTotals(result);
+    setErrors({});
+  }, [monthInput, categoryInput]);
+
+  return (
+    <section className="expenses" aria-labelledby="expenses-heading">
+      <h2 id="expenses-heading">Expenses Summary</h2>
+      <p className="lead">Use the filters to explore monthly spending at a glance.</p>
+      <div className="field-grid">
+        <MonthSelector
+          value={monthInput}
+          onChange={setMonthInput}
+          options={months}
+          error={errors.month ?? null}
+        />
+        <CategorySelector
+          value={categoryInput}
+          onChange={setCategoryInput}
+          options={categories}
+          error={errors.category ?? null}
+        />
+      </div>
+      <TotalsPanel
+        totals={totals}
+        currency={EXPENSES_DATASET.currency}
+        hasActiveFilters={Boolean(normalizeFilterValue(monthInput) || normalizeFilterValue(categoryInput))}
+      />
+    </section>
+  );
+}
