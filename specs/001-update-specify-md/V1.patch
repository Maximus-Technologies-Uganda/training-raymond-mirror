+import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import Expenses from '../pages/Expenses';
+
+describe('Expenses page', () => {
+  it('lists available months and categories for quick selection', () => {
+    const { container } = render(<Expenses />);
+
+    const monthOptions = Array.from(
+      container.querySelectorAll('#expenses-month-options option')
+    ).map((option) => option.getAttribute('value'));
+    const categoryOptions = Array.from(
+      container.querySelectorAll('#expenses-category-options option')
+    ).map((option) => option.getAttribute('value'));
+
+    expect(monthOptions).toEqual(
+      expect.arrayContaining(['January', 'February', 'March'])
+    );
+    expect(categoryOptions).toEqual(
+      expect.arrayContaining(['Groceries', 'Transport', 'Utilities'])
+    );
+  });
+
+  it('filters totals by month and category', async () => {
+    const user = userEvent.setup();
+    render(<Expenses />);
+
+    const monthInput = screen.getByLabelText(/Month filter/i);
+    const categoryInput = screen.getByLabelText(/Category filter/i);
+
+    await user.clear(monthInput);
+    await user.type(monthInput, 'February');
+    await user.clear(categoryInput);
+    await user.type(categoryInput, 'Groceries');
+
+    expect(await screen.findByTestId('expenses-total')).toHaveTextContent(
+      'Total: $95.10'
+    );
+
+    const groceryRow = await screen.findByRole('row', { name: /Groceries/i });
+    expect(groceryRow).toHaveTextContent('$95.10');
+  });
+
+  it('shows inline errors for unknown month or category', async () => {
+    const user = userEvent.setup();
+    render(<Expenses />);
+
+    const monthInput = screen.getByLabelText(/Month filter/i);
+    await user.clear(monthInput);
+    await user.type(monthInput, 'Smarch');
+
+    expect(
+      await screen.findByText(/Unknown month "Smarch"/i)
+    ).toBeInTheDocument();
+    expect(screen.queryByTestId('expenses-total')).not.toBeInTheDocument();
+
+    const categoryInput = screen.getByLabelText(/Category filter/i);
+    await user.clear(categoryInput);
+    await user.type(categoryInput, 'Snacks');
+
+    expect(
+      await screen.findByText(/Unknown category "Snacks"/i)
+    ).toBeInTheDocument();
+  });
+});
