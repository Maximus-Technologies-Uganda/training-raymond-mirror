+import type { ChangeEventHandler } from 'react';
+
+interface CategorySelectorProps {
+  value: string;
+  options: string[];
+  error?: string | null;
+  onChange: (value: string) => void;
+}
+
+export default function CategorySelector({
+  value,
+  options,
+  error,
+  onChange
+}: CategorySelectorProps): JSX.Element {
+  const handleChange: ChangeEventHandler<HTMLInputElement> = (event) => {
+    onChange(event.target.value);
+  };
+
+  return (
+    <div className="field">
+      <label htmlFor="expenses-category">Category filter</label>
+      <input
+        id="expenses-category"
+        name="expenses-category"
+        type="text"
+        value={value}
+        onChange={handleChange}
+        list="expenses-category-options"
+        aria-describedby={error ? 'expenses-category-error' : undefined}
+        placeholder="e.g. Groceries"
+      />
+      <datalist id="expenses-category-options">
+        {options.map((category) => (
+          <option key={category} value={category} />
+        ))}
+      </datalist>
+      {error ? (
+        <p id="expenses-category-error" role="alert" className="field-error">
+          {error}
+        </p>
+      ) : null}
+    </div>
+  );
+}
