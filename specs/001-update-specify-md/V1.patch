+import { describe, expect, it } from 'vitest';
+import { createSeededRandom, createTestClock } from './helpers.js';
+
+describe('createSeededRandom', () => {
+  it('produces deterministic sequences for the same seed', () => {
+    const first = createSeededRandom('week3');
+    const second = createSeededRandom('week3');
+
+    const firstSequence = [first(), first(), first()];
+    const secondSequence = [second(), second(), second()];
+
+    expect(firstSequence).toEqual(secondSequence);
+  });
+
+  it('produces different sequences for different seeds', () => {
+    const first = createSeededRandom('week3-a');
+    const second = createSeededRandom('week3-b');
+
+    expect(first()).not.toEqual(second());
+  });
+});
+
+describe('createTestClock', () => {
+  it('returns the baseline date on now()', () => {
+    const baseline = new Date('2025-11-03T08:00:00Z');
+    const clock = createTestClock(baseline);
+
+    expect(clock.now()).toEqual(baseline);
+  });
+
+  it('advances forward deterministically', () => {
+    const clock = createTestClock('2025-11-03T08:00:00Z');
+
+    const afterAdvance = clock.advanceBy(60_000);
+
+    expect(afterAdvance.toISOString()).toBe('2025-11-03T08:01:00.000Z');
+    expect(clock.now().toISOString()).toBe('2025-11-03T08:01:00.000Z');
+  });
+
+  it('supports setting and resetting the time', () => {
+    const clock = createTestClock('2025-11-03T08:00:00Z');
+
+    clock.advanceBy(1_000);
+    clock.set('2025-11-04T09:30:00Z');
+    expect(clock.now().toISOString()).toBe('2025-11-04T09:30:00.000Z');
+
+    clock.reset();
+    expect(clock.now().toISOString()).toBe('2025-11-03T08:00:00.000Z');
+  });
+});
