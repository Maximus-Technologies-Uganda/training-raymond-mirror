+import { test, expect } from '@playwright/test';
+
+test('quote filters and deterministic random selection @smoke', async ({ page }) => {
+  await page.goto('/');
+  await page.getByTestId('nav-quote').click();
+
+  await expect(page.getByTestId('quote-title')).toHaveText('Quote explorer');
+
+  const tagInput = page.getByTestId('quote-tag-input');
+  await tagInput.fill('resilience');
+
+  await expect(page.getByTestId('quote-results-count')).toHaveText('Showing 1 result');
+  await expect(page.getByTestId('quote-result-text')).toContainText('Still I rise.');
+
+  const clearButton = page.getByTestId('quote-clear-button');
+  await expect(clearButton).toBeEnabled();
+  await clearButton.click();
+
+  const randomSection = page.getByTestId('quote-random');
+  await expect(randomSection).toBeVisible();
+
+  const seedInput = page.getByTestId('quote-seed-input');
+  await seedInput.fill('alpha');
+  const alphaQuote = await page.getByTestId('quote-result-text').textContent();
+
+  await seedInput.fill('beta');
+  const betaQuote = await page.getByTestId('quote-result-text').textContent();
+  expect(betaQuote).not.toBe(alphaQuote);
+
+  await seedInput.fill('alpha');
+  await expect(page.getByTestId('quote-result-text')).toHaveText(alphaQuote ?? '');
+});
