@@ -0,0 +1,46 @@
+import { type FormEvent, useState } from 'react';
+
+export interface TodoCompleteFormProps {
+  onComplete(id: string): Promise<boolean> | boolean;
+}
+
+export function TodoCompleteForm({ onComplete }: TodoCompleteFormProps): JSX.Element {
+  const [taskId, setTaskId] = useState('');
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (isSubmitting) {
+      return;
+    }
+    setIsSubmitting(true);
+    try {
+      const success = await onComplete(taskId.trim());
+      if (success) {
+        setTaskId('');
+      }
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  return (
+    <form className="todo-complete-form" onSubmit={handleSubmit} aria-label="Complete task by id">
+      <div className="todo-complete-form__field">
+        <label htmlFor="todo-complete-id">Complete by id</label>
+        <input
+          id="todo-complete-id"
+          name="todoId"
+          type="text"
+          value={taskId}
+          onChange={(event) => setTaskId(event.target.value)}
+          placeholder="Enter id (e.g., 3)"
+          required
+        />
+      </div>
+      <button type="submit" className="todo-complete-form__submit" disabled={isSubmitting}>
+        {isSubmitting ? 'Completing…' : 'Mark complete'}
+      </button>
+    </form>
+  );
+}
diff --git a/apps/ui/src/components/todo/TodoForm.tsx b/apps/ui/src/components/todo/TodoForm.tsx
