@@ -0,0 +1,111 @@
+import { useMemo, useState } from 'react';
+import TodoAddForm from '../components/todo/TodoAddForm';
+import TodoCompleteForm from '../components/todo/TodoCompleteForm';
+import TodoList from '../components/todo/TodoList';
+import {
+  addTodo,
+  buildTodoList,
+  cloneTodoState,
+  completeTodo,
+  createDefaultState,
+  type TodoFormInput,
+  type TodoState,
+} from '../lib/todo/todos';
+import { createSystemClock, type UiClock } from '../lib/time/clock';
+
+interface ToDoProps {
+  initialState?: TodoState;
+  clock?: UiClock;
+}
+
+interface ActionResult {
+  success: boolean;
+  error?: string;
+}
+
+function ToDo({ initialState, clock }: ToDoProps): JSX.Element {
+  const resolvedClock = useMemo(() => clock ?? createSystemClock(), [clock]);
+  const [state, setState] = useState<TodoState>(() =>
+    initialState ? cloneTodoState(initialState) : createDefaultState(),
+  );
+  const [addError, setAddError] = useState<string | null>(null);
+  const [completeError, setCompleteError] = useState<string | null>(null);
+  const [feedback, setFeedback] = useState<string | null>(null);
+
+  const view = useMemo(() => buildTodoList(state, resolvedClock), [state, resolvedClock]);
+
+  const addAction = (input: TodoFormInput): ActionResult => {
+    try {
+      const result = addTodo(state, input, resolvedClock);
+      setState(result.state);
+      setAddError(null);
+      setFeedback(`Added "${result.todo.title}"`);
+      return { success: true };
+    } catch (error) {
+      const message = (error as Error).message;
+      setAddError(message);
+      setFeedback(null);
+      return { success: false, error: message };
+    }
+  };
+
+  const completeAction = (id: string): ActionResult => {
+    try {
+      const result = completeTodo(state, id, resolvedClock);
+      setState(result.state);
+      setCompleteError(null);
+      if (result.alreadyCompleted) {
+        setFeedback(`Todo "${result.todo.title}" was already completed.`);
+      } else {
+        setFeedback(`Marked "${result.todo.title}" as complete.`);
+      }
+      return { success: true };
+    } catch (error) {
+      const message = (error as Error).message;
+      setCompleteError(message);
+      setFeedback(null);
+      return { success: false, error: message };
+    }
+  };
+
+  return (
+    <section className="todo-page" aria-labelledby="todo-heading">
+      <header className="todo-header">
+        <h1 id="todo-heading">ToDo tracker</h1>
+        <p>
+          Capture, prioritise, and complete actionable work with deterministic clock handling for
+          yesterday/today/tomorrow boundaries.
+        </p>
+      </header>
+
+      {feedback && (
+        <div className="todo-feedback" role="status" data-testid="todo-feedback">
+          {feedback}
+        </div>
+      )}
+
+      <div className="todo-grid">
+        <article className="todo-card" aria-label="Task list">
+          <div className="todo-card__header">
+            <h2>Active tasks</h2>
+            <p>Pending items are ordered by due date and priority before completed work.</p>
+          </div>
+          <TodoList items={view} onComplete={(id) => completeAction(id)} />
+        </article>
+
+        <aside className="todo-card todo-card--forms" aria-label="ToDo controls">
+          <div className="todo-card__section">
+            <h2>Add a task</h2>
+            <TodoAddForm onSubmit={addAction} error={addError} />
+          </div>
+          <div className="todo-card__section">
+            <h2>Complete a task</h2>
+            <TodoCompleteForm onSubmit={completeAction} error={completeError} />
+          </div>
+        </aside>
+      </div>
+    </section>
+  );
+}
+
+export default ToDo;
