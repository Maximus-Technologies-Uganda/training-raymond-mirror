+import { type FormEvent, useState } from 'react';
+
+export interface TodoCompleteFormProps {
+  onSubmit: (id: string) => { success: boolean; error?: string };
+  error?: string | null;
+}
+
+function TodoCompleteForm({ onSubmit, error }: TodoCompleteFormProps): JSX.Element {
+  const [id, setId] = useState('');
+
+  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    const result = onSubmit(id);
+    if (result.success) {
+      setId('');
+    }
+  };
+
+  return (
+    <form className="todo-form" onSubmit={handleSubmit} data-testid="todo-complete-form">
+      <div className="todo-form__field">
+        <label htmlFor="todo-complete-id">Todo ID</label>
+        <input
+          id="todo-complete-id"
+          name="todoId"
+          type="text"
+          inputMode="numeric"
+          value={id}
+          onChange={(event) => setId(event.target.value)}
+          placeholder="Enter id to mark complete"
+          data-testid="todo-complete-input"
+        />
+      </div>
+
+      <button type="submit" className="todo-form__submit" data-testid="todo-complete-submit">
+        Mark complete
+      </button>
+
+      {error && (
+        <p className="todo-form__error" role="alert" data-testid="todo-complete-error">
+          {error}
+        </p>
+      )}
+    </form>
+  );
+}
+
+export default TodoCompleteForm;
