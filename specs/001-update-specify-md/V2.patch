diff --git a/apps/ui/src/lib/time/clock.ts b/apps/ui/src/lib/time/clock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5b0b14853628e6299c50c38076508501ff81a733
--- /dev/null
+++ b/apps/ui/src/lib/time/clock.ts
@@ -0,0 +1,101 @@
+export interface UiClock {
+  now(): Date;
+}
+
+export interface AdjustableClock extends UiClock {
+  set(instant: Date | string | number): void;
+}
+
+const MS_PER_DAY = 86_400_000;
+const DATE_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
+
+function toTimestamp(instant: Date | string | number): number {
+  if (instant instanceof Date) {
+    const value = instant.getTime();
+    if (Number.isNaN(value)) {
+      throw new Error('Invalid date provided to clock.');
+    }
+    return value;
+  }
+
+  if (typeof instant === 'number') {
+    if (!Number.isFinite(instant)) {
+      throw new Error('Timestamp must be finite.');
+    }
+    return instant;
+  }
+
+  const parsed = new Date(instant);
+  const timestamp = parsed.getTime();
+  if (Number.isNaN(timestamp)) {
+    throw new Error('Invalid ISO timestamp provided to clock.');
+  }
+  return timestamp;
+}
+
+function toUtcMidnightTimestamp(date: Date): number {
+  return Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());
+}
+
+function parseDateOnly(value: string): number {
+  if (!DATE_PATTERN.test(value)) {
+    throw new Error('Date must use YYYY-MM-DD format.');
+  }
+  const [year, month, day] = value.split('-').map((part) => Number.parseInt(part, 10));
+  return Date.UTC(year, month - 1, day);
+}
+
+export function toDateOnly(date: Date): string {
+  return date.toISOString().slice(0, 10);
+}
+
+export function createSystemClock(): UiClock {
+  return {
+    now(): Date {
+      return new Date();
+    },
+  };
+}
+
+export function createFixedClock(instant: Date | string | number): UiClock {
+  const baseline = toTimestamp(instant);
+  return {
+    now(): Date {
+      return new Date(baseline);
+    },
+  };
+}
+
+export function createAdjustableClock(initial: Date | string | number): AdjustableClock {
+  let current = toTimestamp(initial);
+  return {
+    now(): Date {
+      return new Date(current);
+    },
+    set(instant: Date | string | number): void {
+      current = toTimestamp(instant);
+    },
+  };
+}
+
+export function differenceInCalendarDays(targetDate: string, clock: UiClock): number {
+  const todayTimestamp = toUtcMidnightTimestamp(clock.now());
+  const targetTimestamp = parseDateOnly(targetDate);
+  return Math.round((targetTimestamp - todayTimestamp) / MS_PER_DAY);
+}
+
+export function isToday(targetDate: string, clock: UiClock): boolean {
+  return differenceInCalendarDays(targetDate, clock) === 0;
+}
+
+export function isTomorrow(targetDate: string, clock: UiClock): boolean {
+  return differenceInCalendarDays(targetDate, clock) === 1;
+}
+
+export function isYesterday(targetDate: string, clock: UiClock): boolean {
+  return differenceInCalendarDays(targetDate, clock) === -1;
+}
+
+export function isPast(targetDate: string, clock: UiClock): boolean {
+  return differenceInCalendarDays(targetDate, clock) < 0;
+}
diff --git a/apps/ui/src/lib/todo/todos.ts b/apps/ui/src/lib/todo/todos.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ee3f73751c98b087665f57a8993d63051ad79ea
--- /dev/null
+++ b/apps/ui/src/lib/todo/todos.ts
@@ -0,0 +1,273 @@
+import { differenceInCalendarDays, toDateOnly, type UiClock } from '../time/clock';
+
+export type TodoPriority = 'high' | 'medium' | 'low';
+
+export interface TodoItem {
+  id: string;
+  title: string;
+  priority: TodoPriority;
+  completed: boolean;
+  createdAt: string;
+  dueDate?: string;
+  completedAt?: string;
+}
+
+export interface TodoState {
+  items: TodoItem[];
+  nextId: number;
+}
+
+export interface TodoFormInput {
+  title: string;
+  priority: TodoPriority;
+  dueDate?: string;
+}
+
+export type TodoDueStatus = 'overdue' | 'today' | 'tomorrow' | 'upcoming' | 'none' | 'completed';
+
+export interface TodoViewItem extends TodoItem {
+  dueStatus: TodoDueStatus;
+  statusLabel: string;
+}
+
+const PRIORITY_ORDER: Record<TodoPriority, number> = {
+  high: 0,
+  medium: 1,
+  low: 2,
+};
+
+const STATUS_LABELS: Record<TodoDueStatus, string> = {
+  overdue: 'Overdue',
+  today: 'Due today',
+  tomorrow: 'Due tomorrow',
+  upcoming: 'Upcoming',
+  none: 'No due date',
+  completed: 'Completed',
+};
+
+const DATE_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
+
+const SAMPLE_TODO_ITEMS: readonly TodoItem[] = [
+  {
+    id: '1',
+    title: 'Prepare sprint brief',
+    priority: 'high',
+    dueDate: '2025-03-14',
+    completed: false,
+    createdAt: '2025-03-10T09:00:00.000Z',
+  },
+  {
+    id: '2',
+    title: 'Run standup dry run',
+    priority: 'medium',
+    dueDate: '2025-03-15',
+    completed: false,
+    createdAt: '2025-03-11T10:00:00.000Z',
+  },
+  {
+    id: '3',
+    title: 'Schedule customer follow-up',
+    priority: 'low',
+    dueDate: '2025-03-16',
+    completed: false,
+    createdAt: '2025-03-12T14:30:00.000Z',
+  },
+  {
+    id: '4',
+    title: 'Archive sprint notes',
+    priority: 'low',
+    completed: true,
+    createdAt: '2025-03-08T08:30:00.000Z',
+    completedAt: '2025-03-12T16:45:00.000Z',
+  },
+];
+
+export const DEFAULT_TODO_ITEMS: readonly TodoItem[] = SAMPLE_TODO_ITEMS;
+
+function cloneItem(item: TodoItem): TodoItem {
+  return { ...item };
+}
+
+export function cloneTodoState(state: TodoState): TodoState {
+  return {
+    nextId: state.nextId,
+    items: state.items.map(cloneItem),
+  };
+}
+
+export function createDefaultState(): TodoState {
+  return {
+    items: SAMPLE_TODO_ITEMS.map(cloneItem),
+    nextId: SAMPLE_TODO_ITEMS.length + 1,
+  };
+}
+
+function normalizeTitle(raw: string): string {
+  return raw.trim();
+}
+
+function normalizePriority(priority: string): TodoPriority {
+  const normalized = priority.toLowerCase();
+  if (normalized === 'high' || normalized === 'medium' || normalized === 'low') {
+    return normalized;
+  }
+  throw new Error('Priority must be one of high, medium, or low.');
+}
+
+function validateDueDate(value: string): string {
+  if (!DATE_PATTERN.test(value)) {
+    throw new Error('Due date must use YYYY-MM-DD format.');
+  }
+  const parsed = new Date(value);
+  if (Number.isNaN(parsed.getTime())) {
+    throw new Error('Invalid due date.');
+  }
+  return value;
+}
+
+function findDuplicate(state: TodoState, title: string): boolean {
+  return state.items.some((todo) => todo.title.toLowerCase() === title.toLowerCase());
+}
+
+function buildTodoId(state: TodoState): string {
+  return String(state.nextId);
+}
+
+function determineDueStatus(todo: TodoItem, clock: UiClock): TodoDueStatus {
+  if (todo.completed) {
+    return 'completed';
+  }
+  if (!todo.dueDate) {
+    return 'none';
+  }
+  const difference = differenceInCalendarDays(todo.dueDate, clock);
+  if (difference < 0) {
+    return 'overdue';
+  }
+  if (difference === 0) {
+    return 'today';
+  }
+  if (difference === 1) {
+    return 'tomorrow';
+  }
+  return 'upcoming';
+}
+
+function dueDateSortKey(todo: TodoItem): number {
+  if (!todo.dueDate) {
+    return Number.POSITIVE_INFINITY;
+  }
+  const [year, month, day] = todo.dueDate.split('-').map((part) => Number.parseInt(part, 10));
+  return Date.UTC(year, month - 1, day);
+}
+
+function compareTodos(a: TodoItem, b: TodoItem): number {
+  if (a.completed !== b.completed) {
+    return a.completed ? 1 : -1;
+  }
+
+  const dueComparison = dueDateSortKey(a) - dueDateSortKey(b);
+  if (dueComparison !== 0) {
+    return dueComparison;
+  }
+
+  const priorityComparison = PRIORITY_ORDER[a.priority] - PRIORITY_ORDER[b.priority];
+  if (priorityComparison !== 0) {
+    return priorityComparison;
+  }
+
+  return Number.parseInt(a.id, 10) - Number.parseInt(b.id, 10);
+}
+
+export function addTodo(state: TodoState, input: TodoFormInput, clock: UiClock): { state: TodoState; todo: TodoItem } {
+  const title = normalizeTitle(input.title);
+  if (title.length === 0) {
+    throw new Error('Title is required.');
+  }
+
+  if (findDuplicate(state, title)) {
+    throw new Error('A todo with the same title already exists.');
+  }
+
+  const priority = normalizePriority(input.priority);
+  const dueDate = input.dueDate ? validateDueDate(input.dueDate) : undefined;
+  const createdAt = clock.now().toISOString();
+
+  const todo: TodoItem = {
+    id: buildTodoId(state),
+    title,
+    priority,
+    completed: false,
+    createdAt,
+  };
+
+  if (dueDate) {
+    todo.dueDate = dueDate;
+  }
+
+  const nextState: TodoState = {
+    items: [...state.items, todo],
+    nextId: state.nextId + 1,
+  };
+
+  return { state: nextState, todo };
+}
+
+export function completeTodo(
+  state: TodoState,
+  id: string,
+  clock: UiClock,
+): { state: TodoState; todo: TodoItem; alreadyCompleted: boolean } {
+  const normalizedId = id.trim();
+  if (!normalizedId) {
+    throw new Error('Todo id is required.');
+  }
+
+  const index = state.items.findIndex((todo) => todo.id === normalizedId);
+  if (index === -1) {
+    throw new Error('Todo not found.');
+  }
+
+  const target = state.items[index];
+  if (target.completed) {
+    return { state, todo: target, alreadyCompleted: true };
+  }
+
+  const completedAt = clock.now().toISOString();
+  const updated: TodoItem = { ...target, completed: true, completedAt };
+  const items = [...state.items];
+  items[index] = updated;
+  return { state: { items, nextId: state.nextId }, todo: updated, alreadyCompleted: false };
+}
+
+export function buildTodoList(state: TodoState, clock: UiClock): TodoViewItem[] {
+  return state.items
+    .slice()
+    .sort(compareTodos)
+    .map((item) => {
+      const dueStatus = determineDueStatus(item, clock);
+      return {
+        ...item,
+        dueStatus,
+        statusLabel: STATUS_LABELS[dueStatus],
+      };
+    });
+}
+
+export function formatTodoDueDate(todo: TodoItem): string {
+  if (!todo.dueDate) {
+    return '—';
+  }
+  const [year, month, day] = todo.dueDate.split('-').map((part) => Number.parseInt(part, 10));
+  const formatter = new Intl.DateTimeFormat('en-US', {
+    month: 'short',
+    day: 'numeric',
+    year: 'numeric',
+  });
+  const parsed = new Date(Date.UTC(year, month - 1, day));
+  return formatter.format(parsed);
+}
+
+export function describeTodoTimestamp(clock: UiClock): string {
+  return toDateOnly(clock.now());
+}
diff --git a/apps/ui/src/pages/ToDo.tsx b/apps/ui/src/pages/ToDo.tsx
