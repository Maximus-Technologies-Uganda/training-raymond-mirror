diff --git a/apps/ui/src/lib/expenses/totals.ts b/apps/ui/src/lib/expenses/totals.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e514b6a095ff5f99089cadeb5bd5719849987be
--- /dev/null
+++ b/apps/ui/src/lib/expenses/totals.ts
@@ -0,0 +1,270 @@
+export interface ExpenseRecord {
+  id: string;
+  isoDate: string;
+  monthIndex: number;
+  category: string;
+  amount: number;
+  currency: string;
+}
+
+export interface ExpenseRowError {
+  rowNumber: number;
+  message: string;
+  raw: string;
+}
+
+export interface ExpenseDataset {
+  records: ExpenseRecord[];
+  errors: ExpenseRowError[];
+  monthOptions: MonthOption[];
+  categoryOptions: string[];
+}
+
+export interface MonthOption {
+  value: string;
+  label: string;
+}
+
+export interface ExpenseFilters {
+  month?: string | null;
+  category?: string | null;
+}
+
+export interface ExpenseSummaryEntry {
+  category: string;
+  amount: number;
+}
+
+export interface ExpenseSummary {
+  total: number;
+  totalsByCategory: ExpenseSummaryEntry[];
+}
+
+export type ExpenseComputationStatus = 'ok' | 'empty' | 'invalid';
+
+export interface ExpenseComputationResult {
+  status: ExpenseComputationStatus;
+  entries: ExpenseRecord[];
+  summary: ExpenseSummary;
+  validation: Partial<Record<'month' | 'category', string>>;
+}
+
+const RAW_EXPENSES = `date,category,amount,currency
+2025-01-05,Groceries,54.20,USD
+2025-01-15,Transport,18.30,USD
+2025-02-01,Groceries,42.10,USD
+2025-02-07,Utilities,90.00,USD
+2025-02-14,Travel,,USD
+2025-03-12,Entertainment,27.50,USD
+2025-03-25,Groceries,38.40,USD
+2025-03-29,Transport,55.00,USD
+`;
+
+const MONTH_METADATA: Array<{ index: number; label: string; aliases: string[] }> = [
+  { index: 1, label: 'January', aliases: ['jan', 'january'] },
+  { index: 2, label: 'February', aliases: ['feb', 'february'] },
+  { index: 3, label: 'March', aliases: ['mar', 'march'] },
+  { index: 4, label: 'April', aliases: ['apr', 'april'] },
+  { index: 5, label: 'May', aliases: ['may'] },
+  { index: 6, label: 'June', aliases: ['jun', 'june'] },
+  { index: 7, label: 'July', aliases: ['jul', 'july'] },
+  { index: 8, label: 'August', aliases: ['aug', 'august'] },
+  { index: 9, label: 'September', aliases: ['sep', 'sept', 'september'] },
+  { index: 10, label: 'October', aliases: ['oct', 'october'] },
+  { index: 11, label: 'November', aliases: ['nov', 'november'] },
+  { index: 12, label: 'December', aliases: ['dec', 'december'] },
+];
+
+const MONTH_LOOKUP = new Map<string, number>(
+  MONTH_METADATA.flatMap((entry) => [[String(entry.index), entry.index], ...entry.aliases.map((alias) => [alias, entry.index])]),
+);
+
+const CURRENCY_FALLBACK = 'USD';
+
+const TWO_DECIMAL_FORMATTER = new Intl.NumberFormat('en-US', {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+
+let datasetCache: ExpenseDataset | null = null;
+
+export function loadExpenseDataset(): ExpenseDataset {
+  if (datasetCache) {
+    return datasetCache;
+  }
+
+  const { records, errors } = parseCsvWithErrors(RAW_EXPENSES);
+  const monthOptions = deriveMonthOptions(records);
+  const categoryOptions = deriveCategoryOptions(records);
+
+  datasetCache = { records, errors, monthOptions, categoryOptions };
+  return datasetCache;
+}
+
+function parseCsvWithErrors(raw: string): { records: ExpenseRecord[]; errors: ExpenseRowError[] } {
+  const rows = raw
+    .split(/\r?\n/)
+    .map((line) => line.trim())
+    .filter((line) => line.length > 0);
+
+  if (rows.length === 0) {
+    return { records: [], errors: [] };
+  }
+
+  const [firstLine] = rows;
+  const hasHeader = /date/i.test(firstLine) && /category/i.test(firstLine) && /amount/i.test(firstLine);
+  const startIndex = hasHeader ? 1 : 0;
+
+  const records: ExpenseRecord[] = [];
+  const errors: ExpenseRowError[] = [];
+
+  for (let index = startIndex; index < rows.length; index += 1) {
+    const rawRow = rows[index];
+    const rowNumber = index + 1; // 1-based index for readability
+    const columns = rawRow.split(',').map((column) => column.trim());
+    const [date, category, amount, currency = CURRENCY_FALLBACK] = columns;
+
+    if (!date) {
+      errors.push({ rowNumber, raw: rawRow, message: 'Date is required.' });
+      continue;
+    }
+
+    const parsedDate = new Date(date);
+    if (Number.isNaN(parsedDate.getTime())) {
+      errors.push({ rowNumber, raw: rawRow, message: 'Invalid date value.' });
+      continue;
+    }
+
+    if (!category) {
+      errors.push({ rowNumber, raw: rawRow, message: 'Category is required.' });
+      continue;
+    }
+
+    if (!amount) {
+      errors.push({ rowNumber, raw: rawRow, message: 'Amount is required.' });
+      continue;
+    }
+
+    const numericAmount = Number.parseFloat(amount);
+    if (!Number.isFinite(numericAmount)) {
+      errors.push({ rowNumber, raw: rawRow, message: 'Amount must be numeric.' });
+      continue;
+    }
+
+    const monthIndex = parsedDate.getUTCMonth() + 1;
+    records.push({
+      id: `${rowNumber}`,
+      isoDate: parsedDate.toISOString().slice(0, 10),
+      monthIndex,
+      category,
+      amount: numericAmount,
+      currency: currency || CURRENCY_FALLBACK,
+    });
+  }
+
+  return { records, errors };
+}
+
+function deriveMonthOptions(records: ExpenseRecord[]): MonthOption[] {
+  const uniqueMonths = new Set<number>();
+  for (const record of records) {
+    uniqueMonths.add(record.monthIndex);
+  }
+
+  return Array.from(uniqueMonths)
+    .sort((a, b) => a - b)
+    .map((monthIndex) => ({ value: MONTH_METADATA[monthIndex - 1]?.label ?? String(monthIndex), label: MONTH_METADATA[monthIndex - 1]?.label ?? String(monthIndex) }));
+}
+
+function deriveCategoryOptions(records: ExpenseRecord[]): string[] {
+  const uniqueCategories = new Set<string>();
+  for (const record of records) {
+    uniqueCategories.add(record.category);
+  }
+  return Array.from(uniqueCategories).sort((a, b) => a.localeCompare(b));
+}
+
+function normalizeMonthInput(rawMonth: string): number {
+  const trimmed = rawMonth.trim();
+  if (!trimmed) {
+    throw new Error('Month cannot be empty.');
+  }
+
+  const candidate = trimmed.toLowerCase();
+  if (MONTH_LOOKUP.has(candidate)) {
+    return MONTH_LOOKUP.get(candidate)!;
+  }
+
+  if (/^\d+$/.test(candidate)) {
+    const value = Number.parseInt(candidate, 10);
+    if (value >= 1 && value <= 12) {
+      return value;
+    }
+  }
+
+  throw new Error(`Unknown month "${rawMonth}". Use Jan–Dec or 1–12.`);
+}
+
+function findMatchingCategory(records: ExpenseRecord[], rawCategory: string): string | null {
+  const normalized = rawCategory.trim().toLowerCase();
+  if (!normalized) {
+    return null;
+  }
+  const match = records.find((record) => record.category.toLowerCase() === normalized);
+  return match ? match.category : null;
+}
+
+function summarizeRecords(records: ExpenseRecord[]): ExpenseSummary {
+  const total = records.reduce((sum, record) => sum + record.amount, 0);
+  const totalsByCategory = records.reduce<ExpenseSummaryEntry[]>((acc, record) => {
+    const existing = acc.find((entry) => entry.category.toLowerCase() === record.category.toLowerCase());
+    if (existing) {
+      existing.amount += record.amount;
+      return acc;
+    }
+    return [...acc, { category: record.category, amount: record.amount }];
+  }, []);
+  return { total, totalsByCategory };
+}
+
+function emptySummary(): ExpenseSummary {
+  return { total: 0, totalsByCategory: [] };
+}
+
+export function evaluateExpenses(records: ExpenseRecord[], filters: ExpenseFilters = {}): ExpenseComputationResult {
+  const validation: ExpenseComputationResult['validation'] = {};
+  let filteredRecords = [...records];
+
+  if (filters.month && filters.month.trim().length > 0) {
+    try {
+      const monthIndex = normalizeMonthInput(filters.month);
+      filteredRecords = filteredRecords.filter((record) => record.monthIndex === monthIndex);
+    } catch (error) {
+      validation.month = error instanceof Error ? error.message : 'Unknown month.';
+      return { status: 'invalid', entries: [], summary: emptySummary(), validation };
+    }
+  }
+
+  if (filters.category && filters.category.trim().length > 0) {
+    const match = findMatchingCategory(records, filters.category);
+    if (!match) {
+      validation.category = `Unknown category "${filters.category}".`;
+      return { status: 'invalid', entries: [], summary: emptySummary(), validation };
+    }
+    filteredRecords = filteredRecords.filter((record) => record.category.toLowerCase() === match.toLowerCase());
+  }
+
+  if (filteredRecords.length === 0) {
+    return { status: 'empty', entries: [], summary: emptySummary(), validation };
+  }
+
+  return { status: 'ok', entries: filteredRecords, summary: summarizeRecords(filteredRecords), validation };
+}
+
+export function formatCurrency(value: number): string {
+  return `$${TWO_DECIMAL_FORMATTER.format(value)}`;
+}
+
+export function monthLabelFromIndex(monthIndex: number): string {
+  return MONTH_METADATA[monthIndex - 1]?.label ?? String(monthIndex);
+}
