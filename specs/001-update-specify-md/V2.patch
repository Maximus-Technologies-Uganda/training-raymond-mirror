@@ -0,0 +1,27 @@
+import { test, expect } from '@playwright/test';
+
+/**
+ * Phase 4 ToDo UI smoke test
+ * Verifies add → list → complete flow using deterministic UI components.
+ */
+test('todo workflow add list complete @smoke', async ({ page }) => {
+  await page.goto('/');
+
+  const todoLink = page.getByTestId('nav-todo');
+  await todoLink.click();
+
+  await expect(page.getByRole('heading', { name: 'ToDo tracker' })).toBeVisible();
+
+  const addForm = page.getByTestId('todo-add-form');
+  await addForm.getByLabel('Title').fill('Ship release notes');
+  await addForm.getByRole('button', { name: /Add task/i }).click();
+
+  const row = page.getByRole('row', { name: /Ship release notes/i });
+  await expect(row).toBeVisible();
+
+  const completeButton = row.getByRole('button', { name: /Mark.*complete/i });
+  await completeButton.click();
+
+  await expect(completeButton).toBeDisabled();
+  await expect(page.getByTestId('todo-feedback')).toContainText('Marked "Ship release notes" as complete.');
+});
