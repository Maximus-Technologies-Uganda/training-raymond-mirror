+interface CategorySelectorProps {
+  value: string;
+  options: string[];
+  onChange: (value: string) => void;
+  error?: string;
+}
+
+const CATEGORY_INPUT_ID = 'expenses-category-input';
+const CATEGORY_DATALIST_ID = 'expenses-category-options';
+
+function CategorySelector({ value, options, onChange, error }: CategorySelectorProps): JSX.Element {
+  return (
+    <div className="field">
+      <label htmlFor={CATEGORY_INPUT_ID}>Category</label>
+      <input
+        id={CATEGORY_INPUT_ID}
+        list={CATEGORY_DATALIST_ID}
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        placeholder="All categories"
+        aria-describedby={error ? `${CATEGORY_INPUT_ID}-error` : undefined}
