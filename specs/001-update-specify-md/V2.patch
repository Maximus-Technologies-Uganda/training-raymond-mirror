+import { describe, expect, it } from 'vitest';
+import { createSeededRandom, createTestClock } from './helpers.js';
+
+describe('createSeededRandom', () => {
+  it('produces deterministic sequences for the same seed', () => {
+    const generatorA = createSeededRandom(42);
+    const generatorB = createSeededRandom(42);
+
+    const sequenceA = [generatorA.next(), generatorA.next(), generatorA.next()];
+    const sequenceB = [generatorB.next(), generatorB.next(), generatorB.next()];
+
+    expect(sequenceA).toEqual(sequenceB);
+  });
+
+  it('supports resetting to the initial seed', () => {
+    const generator = createSeededRandom('seed');
+
+    const firstRun = [generator.nextInt(10), generator.nextInt(10)];
+    generator.reset();
+    const secondRun = [generator.nextInt(10), generator.nextInt(10)];
+
+    expect(firstRun).toEqual(secondRun);
+  });
+
+  it('selects stable items when using pick', () => {
+    const generator = createSeededRandom(7);
+    const items = ['alpha', 'beta', 'gamma', 'delta'];
+
+    const picked = [
+      generator.pick(items),
+      generator.pick(items),
+      generator.pick(items),
+    ];
+
+    expect(picked).toMatchInlineSnapshot(`
+      [
+        "alpha",
+        "alpha",
+        "delta",
+      ]
+    `);
+  });
+});
+
+describe('createTestClock', () => {
+  it('starts at the provided instant', () => {
+    const clock = createTestClock('2025-01-01T00:00:00Z');
+    expect(clock.now().toISOString()).toBe('2025-01-01T00:00:00.000Z');
+  });
+
+  it('advances deterministically by milliseconds', () => {
+    const clock = createTestClock('2025-01-01T00:00:00Z');
+    clock.advanceBy(60_000);
+    expect(clock.now().toISOString()).toBe('2025-01-01T00:01:00.000Z');
+  });
+
+  it('sets absolute time using advanceTo', () => {
+    const clock = createTestClock('2025-01-01T00:00:00Z');
+    clock.advanceTo('2025-02-01T12:34:56Z');
+    expect(clock.now().toISOString()).toBe('2025-02-01T12:34:56.000Z');
+  });
+
+  it('runs callbacks with temporarily fixed time', () => {
+    const clock = createTestClock('2025-01-01T00:00:00Z');
+    const result = clock.withFixedNow('2025-12-31T23:59:59Z', () => clock.now().toISOString());
+
+    expect(result).toBe('2025-12-31T23:59:59.000Z');
+    expect(clock.now().toISOString()).toBe('2025-01-01T00:00:00.000Z');
+  });
+});
