@@ -0,0 +1,127 @@
+import { render, screen, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import Expenses from '../pages/Expenses';
+import {
+  evaluateExpenses,
+  formatCurrency,
+  loadExpenseDataset,
+  type ExpenseFilters,
+} from '../lib/expenses/totals';
+
+describe('expenses totals logic', () => {
+  const dataset = loadExpenseDataset();
+
+  it('captures malformed rows for transparency', () => {
+    expect(dataset.errors).not.toHaveLength(0);
+    expect(dataset.errors[0].message.toLowerCase()).toContain('amount');
+  });
+
+  describe.each([
+    { month: 'Jan', expectedTotal: 72.5 },
+    { month: 'February', expectedTotal: 132.1 },
+    { month: 'Mar', expectedTotal: 120.9 },
+  ])('month filtering %#', ({ month, expectedTotal }) => {
+    it(`summarizes totals for ${month}`, () => {
+      const result = evaluateExpenses(dataset.records, { month });
+      expect(result.validation.month).toBeUndefined();
+      expect(result.summary.total).toBeCloseTo(expectedTotal, 2);
+    });
+  });
+
+  describe.each([
+    { category: 'groceries', expectedTotal: 134.7 },
+    { category: 'Transport', expectedTotal: 73.3 },
+    { category: 'ENTERTAINMENT', expectedTotal: 27.5 },
+  ])('category filtering %#', ({ category, expectedTotal }) => {
+    it(`summarizes totals for ${category}`, () => {
+      const result = evaluateExpenses(dataset.records, { category });
+      expect(result.validation.category).toBeUndefined();
+      expect(result.summary.total).toBeCloseTo(expectedTotal, 2);
+    });
+  });
+
+  it('returns validation error for unknown month', () => {
+    const result = evaluateExpenses(dataset.records, { month: 'Smarch' });
+    expect(result.validation.month).toMatch(/unknown month/i);
+  });
+
+  it('returns validation error for unknown category', () => {
+    const result = evaluateExpenses(dataset.records, { category: 'Snacks' });
+    expect(result.validation.category).toMatch(/unknown category/i);
+  });
+
+  it('returns empty result when filters yield no matches', () => {
+    const filters: ExpenseFilters = { month: 'January', category: 'Utilities' };
+    const result = evaluateExpenses(dataset.records, filters);
+    expect(result.entries).toHaveLength(0);
+    expect(result.summary.total).toBe(0);
+    expect(result.status).toBe('empty');
+  });
+});
+
+describe('Expenses page', () => {
+  it('renders totals when selecting month and category', async () => {
+    render(<Expenses />);
+    const user = userEvent.setup();
+
+    const monthField = screen.getByLabelText(/month/i);
+    await user.clear(monthField);
+    await user.type(monthField, 'February');
+    await user.tab();
+
+    const categoryField = screen.getByLabelText(/category/i);
+    await user.clear(categoryField);
+    await user.type(categoryField, 'Utilities');
+    await user.tab();
+
+    expect(await screen.findByTestId('total')).toHaveTextContent(formatCurrency(90));
+    const totalsList = await screen.findByTestId('category-totals');
+    expect(within(totalsList).getByText(/Utilities/)).toBeInTheDocument();
+  });
+
+  it('shows inline error for invalid month input', async () => {
+    render(<Expenses />);
+    const user = userEvent.setup();
+
+    const monthField = screen.getByLabelText(/month/i);
+    await user.clear(monthField);
+    await user.type(monthField, 'Smarch');
+    await user.tab();
+
+    expect(await screen.findByText(/unknown month/i)).toBeInTheDocument();
+  });
+
+  it('shows inline error for invalid category input', async () => {
+    render(<Expenses />);
+    const user = userEvent.setup();
+
+    const categoryField = screen.getByLabelText(/category/i);
+    await user.clear(categoryField);
+    await user.type(categoryField, 'Snacks');
+    await user.tab();
+
+    expect(await screen.findByText(/unknown category/i)).toBeInTheDocument();
+  });
+
+  it('renders helpful message when no results match filters', async () => {
+    render(<Expenses />);
+    const user = userEvent.setup();
+
+    const monthField = screen.getByLabelText(/month/i);
+    await user.clear(monthField);
+    await user.type(monthField, 'January');
+    await user.tab();
+
+    const categoryField = screen.getByLabelText(/category/i);
+    await user.clear(categoryField);
+    await user.type(categoryField, 'Utilities');
+    await user.tab();
+
+    expect(await screen.findByText(/no expenses found/i)).toBeInTheDocument();
+  });
+
+  it('surfaces malformed row warning to the viewer', async () => {
+    render(<Expenses />);
+    expect(await screen.findByText(/malformed row/i)).toBeInTheDocument();
+  });
+});
