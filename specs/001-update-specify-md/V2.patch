+import { useMemo, useState } from 'react';
+import CategorySelector from '../components/expenses/CategorySelector';
+import ExpensesTable from '../components/expenses/ExpensesTable';
+import MonthSelector from '../components/expenses/MonthSelector';
+import TotalsSummary from '../components/expenses/TotalsSummary';
+import {
+  evaluateExpenses,
+  loadExpenseDataset,
+  type ExpenseComputationResult,
+  type ExpenseFilters,
+} from '../lib/expenses/totals';
+
+function Expenses(): JSX.Element {
+  const dataset = useMemo(() => loadExpenseDataset(), []);
+  const [filters, setFilters] = useState<ExpenseFilters>({ month: '', category: '' });
+
+  const result: ExpenseComputationResult = useMemo(
+    () =>
+      evaluateExpenses(dataset.records, {
+        month: filters.month ?? '',
+        category: filters.category ?? '',
+      }),
+    [dataset.records, filters.category, filters.month],
+  );
+
+  const malformedSummary = useMemo(() => {
+    if (dataset.errors.length === 0) {
+      return null;
+    }
+    const [first] = dataset.errors;
+    if (dataset.errors.length === 1) {
+      return `Malformed row ignored (row ${first.rowNumber}: ${first.message})`;
+    }
+    return `${dataset.errors.length} malformed rows ignored. First issue: row ${first.rowNumber} – ${first.message}`;
+  }, [dataset.errors]);
+
+  const updateMonth = (value: string) => {
+    setFilters((previous) => ({ ...previous, month: value }));
+  };
+
+  const updateCategory = (value: string) => {
+    setFilters((previous) => ({ ...previous, category: value }));
+  };
+
+  return (
+    <section className="expenses-page" role="main">
+      <header className="expenses-header">
+        <h1 data-testid="expenses-heading">Expenses explorer</h1>
+        <p>Filter by month and category to mirror the CLI experience in a friendly UI.</p>
+      </header>
+
+      <div className="expenses-controls" role="search">
+        <MonthSelector value={filters.month ?? ''} options={dataset.monthOptions} onChange={updateMonth} error={result.validation.month} />
+        <CategorySelector
+          value={filters.category ?? ''}
+          options={dataset.categoryOptions}
+          onChange={updateCategory}
+          error={result.validation.category}
+        />
+      </div>
+
+      {malformedSummary ? (
+        <div className="notice notice-warning" role="status">
+          {malformedSummary}
+        </div>
+      ) : null}
+
+      {result.status === 'invalid' ? (
+        <p className="notice notice-error" role="alert">
+          Please resolve the highlighted filters to view totals.
+        </p>
+      ) : null}
+
+      {result.status === 'empty' ? (
+        <p className="notice notice-muted" role="status">
+          No expenses found for the selected filters.
+        </p>
+      ) : null}
+
+      {result.status === 'ok' ? (
+        <div className="expenses-results">
+          <TotalsSummary total={result.summary.total} totalsByCategory={result.summary.totalsByCategory} />
+          <ExpensesTable records={result.entries} />
+        </div>
+      ) : null}
+    </section>
+  );
+}
+
+export default Expenses;
diff --git a/apps/ui/src/tests/expenses.test.tsx b/apps/ui/src/tests/expenses.test.tsx
