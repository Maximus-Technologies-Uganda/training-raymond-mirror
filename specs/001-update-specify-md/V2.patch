@@ -0,0 +1,108 @@
+import { render, screen, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import ToDo from '../pages/ToDo';
+import {
+  addTodo,
+  buildTodoList,
+  completeTodo,
+  createDefaultState,
+  type TodoState,
+} from '../lib/todo/todos';
+import { createAdjustableClock } from '../lib/time/clock';
+
+describe('todo logic helpers', () => {
+  it('classifies todos relative to injected clock boundaries', () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const state = createDefaultState();
+    const view = buildTodoList(state, clock);
+
+    const statusByTitle = new Map(view.map((item) => [item.title, item.dueStatus]));
+
+    expect(statusByTitle.get('Prepare sprint brief')).toBe('overdue');
+    expect(statusByTitle.get('Run standup dry run')).toBe('today');
+    expect(statusByTitle.get('Schedule customer follow-up')).toBe('tomorrow');
+    expect(statusByTitle.get('Archive sprint notes')).toBe('completed');
+  });
+
+  it('prevents duplicate titles on add', () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const state = createDefaultState();
+    expect(() =>
+      addTodo(state, { title: 'Prepare sprint brief', priority: 'medium' }, clock),
+    ).toThrowError('A todo with the same title already exists.');
+  });
+
+  it('throws when completing a missing todo id', () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const state = createDefaultState();
+    expect(() => completeTodo(state, '999', clock)).toThrowError('Todo not found.');
+  });
+
+  it('records completion timestamp when marking todo complete', () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    let state: TodoState = createDefaultState();
+    const created = addTodo(state, { title: 'Draft release notes', priority: 'high' }, clock);
+    state = created.state;
+
+    const completed = completeTodo(state, created.todo.id, clock);
+    expect(completed.todo.completed).toBe(true);
+    expect(completed.todo.completedAt).toContain('2025-03-15');
+  });
+});
+
+describe('ToDo page behaviour', () => {
+  it('adds a todo and displays feedback', async () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const user = userEvent.setup();
+    render(<ToDo clock={clock} />);
+
+    const titleInput = within(screen.getByTestId('todo-add-form')).getByTestId('todo-title-input');
+    await user.clear(titleInput);
+    await user.type(titleInput, 'Draft release notes');
+    await user.click(screen.getByTestId('todo-add-submit'));
+
+    expect(await screen.findByText('Draft release notes')).toBeInTheDocument();
+    expect(screen.getByTestId('todo-feedback')).toHaveTextContent('Added "Draft release notes"');
+  });
+
+  it('shows duplicate error inline when adding an existing title', async () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const user = userEvent.setup();
+    render(<ToDo clock={clock} />);
+
+    const titleInput = within(screen.getByTestId('todo-add-form')).getByTestId('todo-title-input');
+    await user.clear(titleInput);
+    await user.type(titleInput, 'Prepare sprint brief');
+    await user.click(screen.getByTestId('todo-add-submit'));
+
+    expect(await screen.findByTestId('todo-add-error')).toHaveTextContent(
+      'A todo with the same title already exists.',
+    );
+  });
+
+  it('surfaces error when completing an unknown id', async () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const user = userEvent.setup();
+    render(<ToDo clock={clock} />);
+
+    const completeForm = screen.getByTestId('todo-complete-form');
+    await user.type(within(completeForm).getByTestId('todo-complete-input'), '999');
+    await user.click(within(completeForm).getByTestId('todo-complete-submit'));
+
+    expect(await screen.findByTestId('todo-complete-error')).toHaveTextContent('Todo not found.');
+  });
+
+  it('marks a todo complete via list action', async () => {
+    const clock = createAdjustableClock('2025-03-15T09:00:00Z');
+    const user = userEvent.setup();
+    render(<ToDo clock={clock} />);
+
+    const completeButton = screen.getByTestId('todo-complete-1');
+
+    await user.click(completeButton);
+
+    expect(completeButton).toBeDisabled();
+    expect(completeButton).toHaveTextContent('Completed');
+    expect(screen.getByTestId('todo-feedback')).toHaveTextContent('Marked "Prepare sprint brief" as complete.');
