+import { formatTodoDueDate, type TodoViewItem } from '../../lib/todo/todos';
+
+export interface TodoListProps {
+  items: readonly TodoViewItem[];
+  onComplete: (id: string) => void;
+}
+
+function TodoList({ items, onComplete }: TodoListProps): JSX.Element {
+  if (items.length === 0) {
+    return (
+      <div className="todo-list__empty" data-testid="todo-empty">
+        No tasks yet. Add your first todo to get started.
+      </div>
+    );
+  }
+
+  return (
+    <table className="todo-table" data-testid="todo-table">
+      <thead>
+        <tr>
+          <th scope="col">ID</th>
+          <th scope="col">Title</th>
+          <th scope="col">Priority</th>
+          <th scope="col">Due</th>
+          <th scope="col">Status</th>
+          <th scope="col" className="todo-table__actions">
+            Actions
+          </th>
+        </tr>
+      </thead>
+      <tbody>
+        {items.map((todo) => (
+          <tr key={todo.id} data-status={todo.dueStatus}>
+            <td>{todo.id}</td>
+            <td className="todo-table__title">{todo.title}</td>
+            <td className={`todo-pill todo-pill--${todo.priority}`}>
+              {todo.priority.charAt(0).toUpperCase() + todo.priority.slice(1)}
+            </td>
+            <td>{todo.dueDate ? formatTodoDueDate(todo) : '—'}</td>
+            <td>
+              <span className={`todo-status todo-status--${todo.dueStatus}`} data-testid={`todo-status-${todo.id}`}>
+                {todo.statusLabel}
+              </span>
+            </td>
+            <td className="todo-table__actions">
+              <button
+                type="button"
+                onClick={() => onComplete(todo.id)}
+                className="todo-table__complete"
+                disabled={todo.completed}
+                aria-label={todo.completed ? `Todo ${todo.title} already completed` : `Mark ${todo.title} complete`}
+                data-testid={`todo-complete-${todo.id}`}
+              >
+                {todo.completed ? 'Completed' : 'Mark complete'}
+              </button>
+            </td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
+
+export default TodoList;
