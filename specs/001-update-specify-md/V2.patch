+import { type FormEvent, useState } from 'react';
+import type { TodoFormInput, TodoPriority } from '../../lib/todo/todos';
+
+export interface TodoAddFormProps {
+  onSubmit: (input: TodoFormInput) => { success: boolean; error?: string };
+  error?: string | null;
+}
+
+const PRIORITY_OPTIONS: readonly { label: string; value: TodoPriority }[] = [
+  { label: 'High', value: 'high' },
+  { label: 'Medium', value: 'medium' },
+  { label: 'Low', value: 'low' },
+];
+
+function TodoAddForm({ onSubmit, error }: TodoAddFormProps): JSX.Element {
+  const [title, setTitle] = useState('');
+  const [dueDate, setDueDate] = useState('');
+  const [priority, setPriority] = useState<TodoPriority>('medium');
+
+  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    const result = onSubmit({
+      title,
+      priority,
+      dueDate: dueDate ? dueDate : undefined,
+    });
+    if (result.success) {
+      setTitle('');
+      setDueDate('');
+      setPriority('medium');
+    }
+  };
+
+  return (
+    <form className="todo-form" onSubmit={handleSubmit} data-testid="todo-add-form">
+      <div className="todo-form__field">
+        <label htmlFor="todo-title">Title</label>
+        <input
+          id="todo-title"
+          name="title"
+          type="text"
+          value={title}
+          onChange={(event) => setTitle(event.target.value)}
+          placeholder="Write status update"
+          required
+          data-testid="todo-title-input"
+        />
+      </div>
+
+      <div className="todo-form__field">
+        <label htmlFor="todo-due-date">Due date</label>
+        <input
+          id="todo-due-date"
+          name="dueDate"
+          type="date"
+          value={dueDate}
+          onChange={(event) => setDueDate(event.target.value)}
+        />
+      </div>
+
+      <div className="todo-form__field">
+        <label htmlFor="todo-priority">Priority</label>
+        <select
+          id="todo-priority"
+          name="priority"
+          value={priority}
+          onChange={(event) => setPriority(event.target.value as TodoPriority)}
+        >
+          {PRIORITY_OPTIONS.map((option) => (
+            <option key={option.value} value={option.value}>
+              {option.label}
+            </option>
+          ))}
+        </select>
+      </div>
+
+      <button type="submit" className="todo-form__submit" data-testid="todo-add-submit">
+        Add task
+      </button>
+
+      {error && (
+        <p className="todo-form__error" role="alert" data-testid="todo-add-error">
+          {error}
+        </p>
+      )}
+    </form>
+  );
+}
+
+export default TodoAddForm;
