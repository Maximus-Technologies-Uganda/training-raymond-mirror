diff --git a/apps/ui/src/tests/todo.test.tsx b/apps/ui/src/tests/todo.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e4a983d29cbf0d9b2182ee1a5432859aa9c93cd8
--- /dev/null
+++ b/apps/ui/src/tests/todo.test.tsx
@@ -0,0 +1,48 @@
+import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import ToDo from '../pages/ToDo';
+import { createTestClock } from './helpers';
+
+describe('ToDo page', () => {
+  it('categorizes tasks by due date relative to the injected clock', () => {
+    const clock = createTestClock('2025-11-03T09:00:00Z');
+    render(<ToDo clock={clock} />);
+
+    expect(screen.getByTestId('todo-due-1')).toHaveTextContent('Due yesterday');
+    expect(screen.getByTestId('todo-due-2')).toHaveTextContent('Due today');
+    expect(screen.getByTestId('todo-due-3')).toHaveTextContent('Due tomorrow');
+  });
+
+  it('filters to only show tasks due today when requested', async () => {
+    const clock = createTestClock('2025-11-03T09:00:00Z');
+    render(<ToDo clock={clock} />);
+
+    const dueTodayToggle = screen.getByTestId('todo-filter-due-today');
+    await userEvent.click(dueTodayToggle);
+
+    expect(screen.queryByTestId('todo-item-1')).not.toBeInTheDocument();
+    expect(screen.queryByTestId('todo-item-2')).toBeInTheDocument();
+    expect(screen.queryByTestId('todo-item-3')).not.toBeInTheDocument();
+  });
+
+  it('shows an error when attempting to add a duplicate title', async () => {
+    const clock = createTestClock('2025-11-03T09:00:00Z');
+    render(<ToDo clock={clock} />);
+
+    await userEvent.type(screen.getByTestId('todo-title-input'), 'Prepare sprint review deck');
+    await userEvent.click(screen.getByTestId('todo-submit'));
+
+    expect(screen.getByTestId('todo-error')).toHaveTextContent('A todo with the same title already exists.');
+    expect(screen.queryByTestId('todo-success')).not.toBeInTheDocument();
+  });
+
+  it('shows an error when completing a non-existent todo id', async () => {
+    const clock = createTestClock('2025-11-03T09:00:00Z');
+    render(<ToDo clock={clock} />);
+
+    await userEvent.type(screen.getByTestId('todo-complete-input'), '999');
+    await userEvent.click(screen.getByTestId('todo-complete-submit'));
+
+    expect(screen.getByTestId('todo-error')).toHaveTextContent('Todo not found.');
+  });
+});
