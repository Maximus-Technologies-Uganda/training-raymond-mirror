diff --git a/apps/ui/scripts/export-coverage.mjs b/apps/ui/scripts/export-coverage.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..241b91e58b064de429cda98cc799700ec04dea5e
--- /dev/null
+++ b/apps/ui/scripts/export-coverage.mjs
@@ -0,0 +1,31 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const projectRoot = path.resolve(__dirname, '..');
+const coverageDir = path.join(projectRoot, 'coverage');
+const targetDir = path.resolve(projectRoot, '..', '..', 'review-artifacts', 'ui', 'unit');
+
+async function ensureDirectory(directoryPath) {
+  await fs.mkdir(directoryPath, { recursive: true });
+}
+
+async function main() {
+  try {
+    await fs.access(coverageDir);
+  } catch (error) {
+    throw new Error('UI coverage directory not found. Run `npm run test:coverage` first.');
+  }
+
+  await ensureDirectory(targetDir);
+  await fs.rm(targetDir, { recursive: true, force: true });
+  await ensureDirectory(targetDir);
+  await fs.cp(coverageDir, targetDir, { recursive: true });
+  console.log(`✓ Copied UI coverage to ${path.relative(projectRoot, targetDir)}`);
+}
+
+main().catch((error) => {
+  console.error(error.message);
+  process.exitCode = 1;
+});
