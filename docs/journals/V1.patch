+++ b/apps/ui/src/lib/expenses/csv.ts
@@ -0,0 +1,128 @@
+import { buildExpenseDataset, type ExpenseDataset, type RawExpenseRow } from './totals';
+
+export const MIN_EXPENSE_ROWS = 5;
+export const MAX_EXPENSE_ROWS = 200;
+
+export interface ExpenseCsvParseResult {
+  dataset: ExpenseDataset;
+  fatalErrors: string[];
+}
+
+const REQUIRED_HEADERS = ['date', 'category', 'amount'] as const;
+const OPTIONAL_HEADERS = ['currency'] as const;
+
+type NormalizedHeader = typeof REQUIRED_HEADERS[number] | typeof OPTIONAL_HEADERS[number];
+
+function splitCsvLine(line: string): string[] {
+  const values: string[] = [];
+  let current = '';
+  let inQuotes = false;
+
+  for (let index = 0; index < line.length; index += 1) {
+    const character = line[index];
+    if (character === '"') {
+      if (inQuotes && line[index + 1] === '"') {
+        current += '"';
+        index += 1;
+      } else {
+        inQuotes = !inQuotes;
+      }
+      continue;
+    }
+
+    if (character === ',' && !inQuotes) {
+      values.push(current);
+      current = '';
+      continue;
+    }
+
+    current += character;
+  }
+
+  values.push(current);
+  return values.map((value) => value.replace(/\r$/, ''));
+}
+
+function normaliseHeader(value: string): string {
+  return value.trim().toLowerCase();
+}
+
+function deriveHeaderMap(cells: readonly string[]): Map<NormalizedHeader, number> {
+  const map = new Map<NormalizedHeader, number>();
+
+  cells.forEach((cell, index) => {
+    const normalised = normaliseHeader(cell) as NormalizedHeader;
+    if (REQUIRED_HEADERS.includes(normalised as typeof REQUIRED_HEADERS[number])
+      || OPTIONAL_HEADERS.includes(normalised as typeof OPTIONAL_HEADERS[number])) {
+      if (!map.has(normalised)) {
+        map.set(normalised, index);
+      }
+    }
+  });
+
+  return map;
+}
+
+function validateHeaders(map: Map<NormalizedHeader, number>): string[] {
+  const missing = REQUIRED_HEADERS.filter((header) => !map.has(header));
+  if (missing.length === 0) {
+    return [];
+  }
+  return [`CSV header missing required columns: ${missing.join(', ')}.`];
+}
+
+export function parseExpensesCsv(contents: string): ExpenseCsvParseResult {
+  const trimmed = contents.trim();
+  if (trimmed.length === 0) {
+    return { dataset: { records: [], issues: [] }, fatalErrors: ['CSV file is empty. Provide header and at least one row.'] };
+  }
+
+  const rawLines = contents
+    .split(/\r?\n/)
+    .map((line) => line.trimEnd())
+    .filter((line) => line.length > 0);
+
+  if (rawLines.length === 0) {
+    return { dataset: { records: [], issues: [] }, fatalErrors: ['CSV file is empty. Provide header and at least one row.'] };
+  }
+
+  const [headerLine, ...dataLines] = rawLines;
+  const headerCells = splitCsvLine(headerLine);
+  const headerMap = deriveHeaderMap(headerCells);
+
+  const headerErrors = validateHeaders(headerMap);
+  if (headerErrors.length > 0) {
+    return { dataset: { records: [], issues: [] }, fatalErrors: headerErrors };
+  }
+
+  const rowCount = dataLines.length;
+  if (rowCount < MIN_EXPENSE_ROWS || rowCount > MAX_EXPENSE_ROWS) {
+    return {
+      dataset: { records: [], issues: [] },
+      fatalErrors: [
+        `CSV must contain between ${MIN_EXPENSE_ROWS} and ${MAX_EXPENSE_ROWS} rows (found ${rowCount}).`,
+      ],
+    };
+  }
+
+  const columnFor = (header: NormalizedHeader): number | undefined => headerMap.get(header);
+
+  const rawRows: RawExpenseRow[] = dataLines.map((line) => {
+    const cells = splitCsvLine(line);
+    const lookup = (header: NormalizedHeader) => {
+      const columnIndex = columnFor(header);
+      return typeof columnIndex === 'number' ? cells[columnIndex]?.trim() ?? '' : '';
+    };
+
+    return {
+      date: lookup('date'),
+      category: lookup('category'),
+      amount: lookup('amount'),
+      currency: columnFor('currency') !== undefined ? lookup('currency') : undefined,
+    };
+  });
+
+  const dataset = buildExpenseDataset(rawRows, { rowOffset: 1 });
+
+  return { dataset, fatalErrors: [] };
+}
