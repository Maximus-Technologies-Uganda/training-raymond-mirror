+
+interface CsvLine {
+  lineNumber: number;
+  raw: string;
+  trimmed: string;
+}
+
+function detectHeader(line: CsvLine | undefined): boolean {
+  if (!line) {
+    return false;
+  }
+  const normalized = line.trimmed.toLowerCase();
+  return normalized.includes('date') && normalized.includes('category') && normalized.includes('amount');
+}
+
+function splitCsvLines(content: string): CsvLine[] {
+  return content
+    .split(/\r?\n/)
+    .map((raw, index) => ({ raw, trimmed: raw.trim(), lineNumber: index + 1 }))
+    .filter((line) => line.trimmed.length > 0);
+}
+
+function parseCsvRows(content: string): { rows: RawExpenseRow[]; issues: ExpenseIssue[]; dataRowCount: number } {
+  const meaningfulLines = splitCsvLines(content);
+  if (meaningfulLines.length === 0) {
+    throw new Error('CSV file is empty. Provide between 5 and 200 data rows.');
+  }
+
+  const [firstLine, ...rest] = meaningfulLines;
+  const hasHeader = detectHeader(firstLine);
+  const dataLines = hasHeader ? rest : meaningfulLines;
+  const dataRowCount = dataLines.length;
+
+  if (dataRowCount < MIN_ROWS || dataRowCount > MAX_ROWS) {
+    throw new Error(`CSV must contain between ${MIN_ROWS} and ${MAX_ROWS} data rows. Received ${dataRowCount}.`);
+  }
+
+  const rows: RawExpenseRow[] = [];
+  const issues: ExpenseIssue[] = [];
+
+  dataLines.forEach((line) => {
+    const columns = line.trimmed.split(',').map((column) => column.trim());
+
+    if (columns.length < 3) {
+      issues.push({
+        rowNumber: line.lineNumber,
+        message: `Row ${line.lineNumber}: expected at least 3 columns (date, category, amount).`,
+      });
+      return;
+    }
+
+    if (columns.length > 4) {
+      issues.push({
+        rowNumber: line.lineNumber,
+        message: `Row ${line.lineNumber}: only date, category, amount, and optional currency are supported.`,
+      });
+      return;
+    }
+
+    const [date, category, amount, currency] = columns;
+    rows.push({
+      date,
+      category,
+      amount,
+      currency,
+      sourceRowNumber: line.lineNumber,
+    });
+  });
+
+  return { rows, issues, dataRowCount };
+}
+
+export interface ExpenseCsvParseResult extends ExpenseDataset {
+  dataRowCount: number;
+  validRowCount: number;
+}
+
+export function parseExpenseCsv(content: string): ExpenseCsvParseResult {
+  const trimmed = content?.trim();
+  if (!trimmed) {
+    throw new Error('CSV file is empty. Provide between 5 and 200 data rows.');
+  }
+
+  const { rows, issues: parseIssues, dataRowCount } = parseCsvRows(content);
+  const dataset = buildExpenseDataset(rows);
+  const allIssues = [...parseIssues, ...dataset.issues].sort((a, b) => a.rowNumber - b.rowNumber);
+
+  return {
+    records: dataset.records,
+    issues: allIssues,
+    dataRowCount,
+    validRowCount: dataset.records.length,
+  };
+}
+
+export { roundToCents };
